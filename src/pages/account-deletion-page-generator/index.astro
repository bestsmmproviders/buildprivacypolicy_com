---
import Layout from '../../layouts/Layout.astro';

const title = "Free Account Deletion Page Generator for Google Play";
const description = "Create the account deletion URL Google Play asks for in the Data safety form. Answer a few questions and get a free hosted page in minutes. No signup needed.";
---

<Layout title={title} description={description} turnstile={true}>

<div class="sticky-header">
  <div class="header-left">
    <a href="/" class="logo-link">
      <svg class="logo-icon" width="28" height="28" viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="128" height="128" rx="28" fill="#1E3A5F"/><path d="M64 24C64 24 40 34 32 38V62C32 82 46 98 64 104C82 98 96 82 96 62V38C88 34 64 24 64 24Z" fill="#2E5A8F" stroke="#5B9BD5" stroke-width="2.5"/><path d="M52 64L60 72L78 54" stroke="white" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span class="logo-text">BuildPrivacyPolicy</span>
    </a>
  </div>
  <nav class="header-nav">
    <a href="/" class="header-nav-link">Privacy Policy Generator</a>
  </nav>
</div>

<main>

<div id="error-toast" class="error-toast" style="display:none"></div>

<div class="hero-section">
  <div class="hero-inner">
    <h1 class="hero-title">Free Account Deletion Page Generator</h1>
    <p class="hero-sub">Get the "Delete account URL" Google Play asks for in the Data safety form. Free hosted page, no signup.</p>
  </div>
</div>

<div class="how-it-works">
  <div class="how-inner">
    <h2 class="how-title">Why you need an account deletion page</h2>
    <p class="how-text">If your app lets people create an account, Google Play requires a web page where users can ask for their account and data to be deleted, even without the app installed. The page must use your app and developer name as shown on your store listing, list the steps to request deletion, and say which data is deleted, which is kept, and for how long. Answer the questions below and we'll host that page for you.</p>
  </div>
</div>

<div id="builder-mode">
<div class="builder-container">

  <!-- 1: App details -->
  <div class="form-card">
    <div class="section-header">
      <div class="section-num">1</div>
      <div>
        <div class="section-title">App Details</div>
        <div class="section-sub">Use the same names as your Google Play listing</div>
      </div>
    </div>

    <div class="field-group">
      <label class="field-label">App name <span class="required">*</span></label>
      <input data-field="appName" placeholder="e.g. My Cool App" class="text-input" />
    </div>

    <div class="field-group">
      <label class="field-label">Developer or company name <span class="required">*</span></label>
      <div class="field-hint">As shown under your app name on Google Play</div>
      <input data-field="developerName" placeholder="e.g. Acme Studios" class="text-input" />
    </div>

    <div class="field-group">
      <label class="field-label">Email for deletion requests <span class="required">*</span></label>
      <input data-field="contactEmail" placeholder="support@example.com" type="email" class="text-input" />
    </div>

    <div class="field-group">
      <label class="field-label">Privacy policy URL</label>
      <div class="field-hint">Optional. Linked at the bottom of the page.</div>
      <input data-field="privacyPolicyUrl" placeholder="https://..." type="url" class="text-input" />
    </div>
  </div>

  <!-- 2: How to delete -->
  <div class="form-card">
    <div class="section-header">
      <div class="section-num">2</div>
      <div>
        <div class="section-title">How Users Delete Their Account</div>
        <div class="section-sub">Pick every way you accept deletion requests</div>
      </div>
    </div>

    <div class="field-group">
      <label class="field-label">Deletion methods <span class="required">*</span></label>
      <div class="field-hint">Google wants a way that works without the app, so email is selected for you</div>
      <div class="chip-container" data-chip-field="deletionMethods" data-mode="multi">
        <div class="chip" data-value="in_app">In the app</div>
        <div class="chip selected" data-value="email">By email</div>
        <div class="chip" data-value="web_form">Online form</div>
        <div class="chip" data-value="support_contact">Contact support</div>
      </div>
    </div>

    <div class="field-group" id="in-app-steps-group" style="display:none">
      <label class="field-label">Steps in the app</label>
      <div class="field-hint">One step per line</div>
      <textarea data-field="inAppSteps" rows="4" class="text-input textarea-input" placeholder={"Open the app\nGo to Settings\nTap Delete account and confirm"}></textarea>
    </div>

    <div class="field-group" id="web-form-group" style="display:none">
      <label class="field-label">Online form URL <span class="required">*</span></label>
      <input data-field="webFormUrl" placeholder="https://..." type="url" class="text-input" />
    </div>
  </div>

  <!-- 3: Data -->
  <div class="form-card">
    <div class="section-header">
      <div class="section-num">3</div>
      <div>
        <div class="section-title">What Happens to the Data</div>
        <div class="section-sub">What's deleted, what's kept, and how long it takes</div>
      </div>
    </div>

    <div class="field-group">
      <label class="field-label">Data that gets deleted</label>
      <div class="chip-container" data-chip-field="deletedData" data-mode="multi">
        <div class="chip selected" data-value="account_info">Account information</div>
        <div class="chip" data-value="profile">Profile</div>
        <div class="chip" data-value="user_content">User content</div>
        <div class="chip" data-value="messages">Messages</div>
        <div class="chip" data-value="preferences">Settings &amp; preferences</div>
        <div class="chip" data-value="activity_history">Activity history</div>
        <div class="chip" data-value="purchase_history">Purchase history</div>
        <div class="chip" data-value="location">Location</div>
        <div class="chip" data-value="photos_media">Photos &amp; media</div>
        <div class="chip" data-value="device_identifiers">Device IDs / push tokens</div>
        <div class="chip" data-value="analytics_data">Analytics data</div>
      </div>
    </div>

    <div class="field-group">
      <label class="field-label">Data you keep after deletion</label>
      <div class="field-hint">Leave empty if you keep nothing</div>
      <div class="chip-container" data-chip-field="retainedData" data-mode="multi">
        <div class="chip" data-value="legal_tax">Legal / tax records</div>
        <div class="chip" data-value="fraud_security">Fraud &amp; security</div>
        <div class="chip" data-value="backups">Backups (until they expire)</div>
        <div class="chip" data-value="anonymized">Anonymized statistics</div>
        <div class="chip" data-value="active_disputes">Open disputes</div>
        <div class="chip" data-value="published_content">Content published to other services</div>
      </div>
    </div>

    <div class="field-group" id="retention-details-group" style="display:none">
      <label class="field-label">How long you keep it</label>
      <textarea data-field="retentionDetails" rows="2" class="text-input textarea-input" placeholder="e.g. Invoices are kept for 7 years as required by tax law. Backups are overwritten within 30 days."></textarea>
    </div>

    <div class="field-group">
      <label class="field-label">How long deletion takes <span class="required">*</span></label>
      <div class="chip-container" data-chip-field="processingTime" data-mode="single">
        <div class="chip" data-value="immediately">Immediately</div>
        <div class="chip" data-value="within_7_days">Within 7 days</div>
        <div class="chip" data-value="within_14_days">Within 14 days</div>
        <div class="chip selected" data-value="within_30_days">Within 30 days</div>
        <div class="chip" data-value="within_60_days">Within 60 days</div>
        <div class="chip" data-value="within_90_days">Within 90 days</div>
      </div>
    </div>

    <div class="field-group">
      <div class="decl-item" data-decl="allowPartial">
        <div class="decl-checkbox"><span class="decl-check">&#10003;</span></div>
        <span class="decl-text">Users can also ask to delete <strong>some</strong> of their data without deleting their account.</span>
      </div>
    </div>
  </div>

  <!-- 4: Declarations -->
  <div class="form-card">
    <div class="section-header">
      <div class="section-num">4</div>
      <div>
        <div class="section-title">Declarations</div>
        <div class="section-sub">Required before generating</div>
      </div>
    </div>
    <div class="field-group">
      <div class="decl-item" data-decl="declAccurate">
        <div class="decl-checkbox"><span class="decl-check">&#10003;</span></div>
        <span class="decl-text">I confirm the answers describe how my app really handles deletion requests.</span>
      </div>
      <div class="decl-item" data-decl="declLegal">
        <div class="decl-checkbox"><span class="decl-check">&#10003;</span></div>
        <span class="decl-text">I understand this is not legal advice and not a substitute for a qualified lawyer.</span>
      </div>
    </div>
  </div>

  <div class="generate-section">
    <div class="cf-turnstile" data-sitekey="0x4AAAAAADwkcRqAcr9CPdKG" data-callback="onTurnstileSuccess" data-theme="light" data-size="normal"></div>
    <button id="generate-btn" class="generate-btn" type="button">Generate Deletion Page</button>
    <div class="generate-sub">Free &middot; No signup &middot; Instant</div>
  </div>

</div>
</div>

<!-- Results -->
<div id="results-mode" style="display:none">
<div class="results-container">

  <div id="back-to-edit" class="back-btn">
    <span class="back-arrow">&larr;</span> Back to editor
  </div>

  <div class="success-header">
    <div class="success-icon"><span>&#10003;</span></div>
    <div class="success-title">Your Deletion Page is Ready</div>
    <div class="success-sub">Paste the URL into Google Play's Data safety form</div>
  </div>

  <div class="hosted-url-card">
    <div class="hosted-label">Delete Account URL</div>
    <a class="hosted-url" id="result-hosted-url" href="#" target="_blank" rel="noopener noreferrer"></a>
    <div class="hosted-hint">Play Console &rsaquo; App content &rsaquo; Data safety &rsaquo; Delete account URL</div>
  </div>

  <div class="export-buttons">
    <button id="btn-copy" class="btn btn-primary" type="button">Copy URL</button>
    <button id="btn-dl-html" class="btn btn-secondary" type="button">Download HTML</button>
  </div>

  <div class="policy-preview-card">
    <div class="preview-label">Page Preview</div>
    <div id="page-preview" class="policy-content"></div>
  </div>

  <div class="disclaimer">
    <strong>Disclaimer:</strong> This page is generated from the answers you provided. It is not legal advice. You are responsible for making sure it matches how your app actually handles deletion requests, and for answering those requests within the time you stated.
  </div>

</div>
</div>

</main>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Free Account Deletion Page Generator",
  "description": description,
  "url": "https://buildprivacypolicy.com/account-deletion-page-generator/",
  "datePublished": "2026-11-03",
  "dateModified": "2026-11-10",
  "author": { "@id": "https://buildprivacypolicy.com/#organization" },
  "publisher": { "@id": "https://buildprivacypolicy.com/#organization" },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://buildprivacypolicy.com/account-deletion-page-generator/"
  }
})} />

</Layout>

