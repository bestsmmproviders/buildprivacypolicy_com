<script is:inline>
(function() {
  var API_BASE = 'https://api.buildprivacypolicy.com';

  var state = {
    appName: '', developerName: '', contactEmail: '', privacyPolicyUrl: '',
    deletionMethods: ['email'], inAppSteps: '', webFormUrl: '',
    deletedData: ['account_info'], retainedData: [], retentionDetails: '',
    processingTime: 'within_30_days', allowPartial: false,
    declAccurate: false, declLegal: false
  };
  var result = { uuid: '', standaloneHtml: '' };
  var turnstileToken = '';
  var errorTimeout = null;

  function $(sel) { return document.querySelector(sel); }

  function pushEvent(name) {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: name });
  }

  function showError(msg) {
    var el = $('#error-toast');
    el.textContent = msg;
    el.style.display = 'block';
    clearTimeout(errorTimeout);
    errorTimeout = setTimeout(function() { el.style.display = 'none'; }, 4000);
  }

  function syncConditional() {
    $('#in-app-steps-group').style.display = state.deletionMethods.indexOf('in_app') !== -1 ? 'block' : 'none';
    $('#web-form-group').style.display = state.deletionMethods.indexOf('web_form') !== -1 ? 'block' : 'none';
    $('#retention-details-group').style.display = state.retainedData.length ? 'block' : 'none';
  }

  document.addEventListener('input', function(e) {
    var field = e.target.getAttribute('data-field');
    if (field && state.hasOwnProperty(field)) state[field] = e.target.value;
  });

  document.addEventListener('click', function(e) {
    var chip = e.target.closest('.chip');
    if (chip) {
      var container = chip.closest('.chip-container');
      var field = container.getAttribute('data-chip-field');
      var value = chip.getAttribute('data-value');
      if (container.getAttribute('data-mode') === 'single') {
        state[field] = value;
        container.querySelectorAll('.chip').forEach(function(c) { c.classList.toggle('selected', c === chip); });
      } else {
        var i = state[field].indexOf(value);
        if (i === -1) state[field].push(value); else state[field].splice(i, 1);
        chip.classList.toggle('selected', i === -1);
      }
      syncConditional();
      return;
    }

    var decl = e.target.closest('.decl-item');
    if (decl) {
      var key = decl.getAttribute('data-decl');
      state[key] = !state[key];
      decl.classList.toggle('checked', state[key]);
      return;
    }

    if (e.target.closest('#generate-btn')) { handleGenerate(); return; }
    if (e.target.closest('#back-to-edit')) {
      $('#results-mode').style.display = 'none';
      $('#builder-mode').style.display = 'block';
      window.scrollTo(0, 0);
      return;
    }
    if (e.target.closest('#btn-copy')) {
      var url = API_BASE + '/delete/' + result.uuid;
      var btn = $('#btn-copy');
      navigator.clipboard.writeText(url).then(function() {
        btn.textContent = 'Copied!';
        setTimeout(function() { btn.textContent = 'Copy URL'; }, 2000);
      });
      return;
    }
    if (e.target.closest('#btn-dl-html')) {
      var blob = new Blob([result.standaloneHtml], { type: 'text/html' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'account-deletion.html';
      a.click();
      URL.revokeObjectURL(a.href);
      return;
    }
  });

  window.onTurnstileSuccess = function(token) { turnstileToken = token; };

  function handleGenerate() {
    var s = state;
    if (!s.appName.trim()) { showError('Please enter the app name'); return; }
    if (!s.developerName.trim()) { showError('Please enter the developer name'); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s.contactEmail.trim())) { showError('Please enter a valid email for deletion requests'); return; }
    if (!s.deletionMethods.length) { showError('Please pick at least one deletion method'); return; }
    if (s.deletionMethods.indexOf('web_form') !== -1 && !/^https?:\/\//i.test(s.webFormUrl.trim())) {
      showError('Please enter the online form URL (starting with https://)');
      return;
    }
    if (!s.declAccurate || !s.declLegal) { showError('Please check both declaration boxes in Step 4'); return; }

    var btn = $('#generate-btn');
    btn.disabled = true;
    btn.textContent = 'Generating...';

    var payload = {
      appName: s.appName.trim(),
      developerName: s.developerName.trim(),
      contactEmail: s.contactEmail.trim(),
      privacyPolicyUrl: s.privacyPolicyUrl.trim(),
      deletionMethods: s.deletionMethods,
      inAppSteps: s.inAppSteps,
      webFormUrl: s.webFormUrl.trim(),
      deletedData: s.deletedData,
      retainedData: s.retainedData,
      retentionDetails: s.retentionDetails,
      processingTime: s.processingTime,
      allowPartial: s.allowPartial,
      declAccurate: s.declAccurate,
      declLegal: s.declLegal,
      turnstileToken: turnstileToken
    };

    fetch(API_BASE + '/api/deletion/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
    .then(function(res) {
      return res.json().catch(function() { return {}; }).then(function(data) {
        if (!res.ok || !data.success) throw new Error(data.error || ('Server error (' + res.status + ')'));
        return data;
      });
    })
    .then(function(data) {
      btn.disabled = false;
      btn.textContent = 'Generate Deletion Page';
      result.uuid = data.uuid;
      result.standaloneHtml = data.standaloneHtml || '';
      pushEvent('deletion_page_complete');

      var url = API_BASE + '/delete/' + data.uuid;
      $('#result-hosted-url').textContent = url;
      $('#result-hosted-url').href = url;
      $('#page-preview').innerHTML = data.pageHtml || '';
      $('#builder-mode').style.display = 'none';
      $('#results-mode').style.display = 'block';
      window.scrollTo(0, 0);
    })
    .catch(function(err) {
      btn.disabled = false;
      btn.textContent = 'Generate Deletion Page';
      if (window.turnstile) window.turnstile.reset();
      showError(err.message || 'Generation failed. Please try again.');
    });
  }

  syncConditional();
})();
</script>
