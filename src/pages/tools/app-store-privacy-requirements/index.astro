        html += '<div class="req-row"><span class="req-label">Where to submit:</span> ' + store.submissionLocation + '</div>';
        html += '<div class="req-row"><span class="req-label">Extra disclosure form:</span> ' + store.extraForm + '</div>';
        html += '<div class="req-row req-form-desc">' + store.extraFormDescription + '</div>';

        /* Data-type declarations for this store */
        var relevantData = dataKeys.filter(function(dk) {
          return store.dataDeclarations[dk];
        });

        if (relevantData.length > 0) {
          html += '<div class="declarations-section">';
          html += '<span class="req-label">Declarations triggered by your data types:</span>';
          html += '<ul class="declaration-list">';
          relevantData.forEach(function(dk) {
            html += '<li><strong>' + DATA_TYPE_LABELS[dk] + ':</strong> ' + store.dataDeclarations[dk] + '</li>';
          });
          html += '</ul>';
          html += '</div>';
        }

        card.innerHTML = html;
        storeResults.appendChild(card);
      });

      /* Build merged clause checklist */
      clauseChecklist.innerHTML = '';
      var activeClauses = [];

      Object.keys(CLAUSE_MAP).forEach(function(clauseKey) {
        var clause = CLAUSE_MAP[clauseKey];

        /* Check if any selected store matches */
        var storeMatch = clause.stores.some(function(s) { return selectedStores[s]; });
        if (!storeMatch) return;

        /* Check data condition if present */
        if (clause.dataCondition) {
          var dataMatch = clause.dataCondition.some(function(d) { return selectedData[d]; });
          if (!dataMatch) return;
        }

        activeClauses.push(clause);

        var triggeredStores = clause.stores.filter(function(s) { return selectedStores[s]; });
        var storeNames = triggeredStores.map(function(s) { return STORE_RULES[s].name; });

        var item = document.createElement('div');
        item.className = 'checklist-item';
        item.innerHTML = '<div class="checklist-check">&#10003;</div>' +
          '<div class="checklist-content">' +
          '<strong>' + clause.label + '</strong>' +
          '<p>' + clause.description + '</p>' +
          '<span class="checklist-stores">Required by: ' + storeNames.join(', ') + '</span>' +
          '</div>';
        clauseChecklist.appendChild(item);
      });

      /* Build plain-text summary */
      var lines = [];
      lines.push('APP STORE PRIVACY REQUIREMENTS SUMMARY');
      lines.push('Generated on ' + new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }));
      lines.push('');
      lines.push('SELECTED STORES: ' + storeKeys.map(function(k) { return STORE_RULES[k].name; }).join(', '));
      if (dataKeys.length > 0) {
        lines.push('SELECTED DATA TYPES: ' + dataKeys.map(function(k) { return DATA_TYPE_LABELS[k]; }).join(', '));
      }
      lines.push('');

      storeKeys.forEach(function(storeKey) {
        var store = STORE_RULES[storeKey];
        lines.push('--- ' + store.name.toUpperCase() + ' ---');
        lines.push('Policy requirement: ' + store.policyRequirement);
        lines.push('Where to submit: ' + store.submissionLocation);
        lines.push('Extra form: ' + store.extraForm);

        var relevantData = dataKeys.filter(function(dk) { return store.dataDeclarations[dk]; });
        if (relevantData.length > 0) {
          lines.push('');
          lines.push('Triggered declarations:');
          relevantData.forEach(function(dk) {
            lines.push('  - ' + DATA_TYPE_LABELS[dk] + ': ' + store.dataDeclarations[dk]);
          });
        }
        lines.push('');
      });

      lines.push('--- PRIVACY POLICY CLAUSE CHECKLIST ---');
      activeClauses.forEach(function(clause) {
        lines.push('[ ] ' + clause.label + ': ' + clause.description);
      });
      lines.push('');
      lines.push('Generated by BuildPrivacyPolicy - https://buildprivacypolicy.com/tools/app-store-privacy-requirements/');

      plainTextOutput.textContent = lines.join('\n');

      formDiv.style.display = 'none';
      resultsDiv.style.display = 'block';

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'tool_complete', stores_checked: storeKeys.length, data_types: dataKeys.length });

      resultsDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    /* ───── COPY BUTTON ───── */

    copyBtn.addEventListener('click', function() {
      var text = plainTextOutput.textContent;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function() {
          showCopyConfirm();
        });
      } else {
        var textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        showCopyConfirm();
      }
    });

    function showCopyConfirm() {
      copyConfirm.style.display = 'inline';
      setTimeout(function() { copyConfirm.style.display = 'none'; }, 2000);
    }

    /* ───── RESET ───── */

    resetBtn.addEventListener('click', function() {
      selectedStores = {};
      selectedData = {};
      document.querySelectorAll('.chip').forEach(function(c) { c.classList.remove('active'); });
      checkBtn.disabled = true;
      resultsDiv.style.display = 'none';
      formDiv.style.display = 'block';
      formDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

</Layout>

