<script>
document.addEventListener('DOMContentLoaded', function() {

  /* ========== CHECKLIST DATA ========== */
  var items = [
    // Lawful Basis
    { id:'lb1', cat:'lawful-basis', text:'Identified a lawful basis (consent, contract, legitimate interest, etc.) for every processing activity', weight:3, severity:'critical', article:'Art. 6(1)', risk:'Processing without a lawful basis is the single most common ground for GDPR enforcement fines.', gate:null },
    { id:'lb2', cat:'lawful-basis', text:'Where consent is the lawful basis, it is freely given, specific, informed, and unambiguous', weight:3, severity:'critical', article:'Art. 7', risk:'Invalid consent means every processing activity that relies on it is unlawful.', gate:null },
    { id:'lb3', cat:'lawful-basis', text:'Documented the lawful basis for each processing activity in an internal record', weight:2, severity:'high', article:'Art. 5(2)', risk:'Without documentation you cannot demonstrate compliance if a supervisory authority audits you.', gate:null },
    { id:'lb4', cat:'lawful-basis', text:'Identified an Article 9 condition for every special-category processing activity', weight:3, severity:'critical', article:'Art. 9', risk:'Special-category data processed without an Article 9 condition triggers higher-tier fines.', gate:'specialCategory' },
    { id:'lb5', cat:'lawful-basis', text:'Users can withdraw consent as easily as they gave it', weight:2, severity:'high', article:'Art. 7(3)', risk:'Making withdrawal harder than giving consent renders the original consent invalid.', gate:null },

    // Transparency
    { id:'tr1', cat:'transparency', text:'Published a publicly accessible, plain-language privacy policy', weight:3, severity:'critical', article:'Art. 12', risk:'No privacy notice means users have no way to understand how their data is processed.', gate:null },
    { id:'tr2', cat:'transparency', text:'Privacy policy states the identity and contact details of the data controller', weight:2, severity:'high', article:'Art. 13(1)(a)', risk:'Users and regulators need to know who is responsible for the data processing.', gate:null },
    { id:'tr3', cat:'transparency', text:'Privacy policy explains the purpose and legal basis for each processing activity', weight:2, severity:'high', article:'Art. 13(1)(c)', risk:'Vague or missing purpose statements are a frequent finding in regulatory audits.', gate:null },
    { id:'tr4', cat:'transparency', text:'Privacy policy lists the categories of personal data collected', weight:2, severity:'high', article:'Art. 14(1)(d)', risk:'Users cannot exercise their rights effectively without knowing what data you hold.', gate:null },
    { id:'tr5', cat:'transparency', text:'Privacy policy states retention periods or the criteria used to determine them', weight:2, severity:'high', article:'Art. 13(2)(a)', risk:'Indefinite retention without justification violates the storage limitation principle.', gate:null },
    { id:'tr6', cat:'transparency', text:'Privacy policy informs users about their data protection rights', weight:2, severity:'high', article:'Art. 13(2)(b)', risk:'Failing to communicate rights prevents users from exercising them.', gate:null },
    { id:'tr7', cat:'transparency', text:'Users are notified before data is used for a new purpose not originally disclosed', weight:2, severity:'medium', article:'Art. 13(3)', risk:'Changing the purpose of processing without notice undermines the transparency requirement.', gate:null },

    // Data Subject Rights
    { id:'dr1', cat:'data-rights', text:'Process in place for individuals to request access to their personal data', weight:3, severity:'critical', article:'Art. 15', risk:'Failing to honour a subject access request is an actionable violation regulators actively investigate.', gate:null },
    { id:'dr2', cat:'data-rights', text:'Individuals can request correction of inaccurate personal data', weight:2, severity:'high', article:'Art. 16', risk:'Holding inaccurate data you refuse to correct undermines the accuracy principle.', gate:null },
    { id:'dr3', cat:'data-rights', text:'Individuals can request erasure of their data when it is no longer necessary', weight:2, severity:'high', article:'Art. 17', risk:'Denying valid erasure requests is one of the most common subjects of GDPR complaints.', gate:null },
    { id:'dr4', cat:'data-rights', text:'Individuals can request restriction of processing in disputed cases', weight:1, severity:'medium', article:'Art. 18', risk:'Without a restriction mechanism you may continue processing data that is contested.', gate:null },
    { id:'dr5', cat:'data-rights', text:'Individuals can receive their data in a portable, machine-readable format', weight:1, severity:'medium', article:'Art. 20', risk:'Data portability supports user autonomy and is increasingly scrutinised by regulators.', gate:null },
    { id:'dr6', cat:'data-rights', text:'Individuals can object to processing based on legitimate interests or direct marketing', weight:2, severity:'high', article:'Art. 21', risk:'Ignoring an objection to direct marketing is a strict-liability violation.', gate:null },
    { id:'dr7', cat:'data-rights', text:'All data subject requests are responded to within one calendar month', weight:2, severity:'high', article:'Art. 12(3)', risk:'Late responses are treated as a failure to comply with the right, even if you eventually respond.', gate:null },

    // Security
    { id:'sc1', cat:'security', text:'Personal data is encrypted in transit (HTTPS/TLS)', weight:3, severity:'critical', article:'Art. 32(1)(a)', risk:'Unencrypted data in transit is trivially interceptable and a near-automatic breach finding.', gate:null },
    { id:'sc2', cat:'security', text:'Personal data is encrypted at rest in databases and backups', weight:2, severity:'high', article:'Art. 32(1)(a)', risk:'Unencrypted storage means a single compromised backup exposes every record.', gate:null },
    { id:'sc3', cat:'security', text:'Role-based access controls limit who can view or modify personal data', weight:2, severity:'high', article:'Art. 32(1)(b)', risk:'Unrestricted access increases the blast radius of any insider threat or account compromise.', gate:null },
    { id:'sc4', cat:'security', text:'A documented data breach response plan is in place', weight:3, severity:'critical', article:'Art. 33', risk:'Without a breach plan you are unlikely to meet the 72-hour notification deadline.', gate:null },
    { id:'sc5', cat:'security', text:'You can notify your supervisory authority within 72 hours of discovering a breach', weight:2, severity:'high', article:'Art. 33(1)', risk:'Missing the 72-hour window is itself a separate violation that draws additional scrutiny.', gate:null },
    { id:'sc6', cat:'security', text:'Data protection by design and by default is applied to new projects and features', weight:2, severity:'medium', article:'Art. 25', risk:'Retrofitting privacy controls is far more expensive and error-prone than building them in.', gate:null },

    // Vendors and Transfers
    { id:'vt1', cat:'vendors', text:'Written Data Processing Agreements are in place with every third-party processor', weight:3, severity:'critical', article:'Art. 28', risk:'Sharing data with a processor without a DPA is an automatic compliance failure.', gate:null },
    { id:'vt2', cat:'vendors', text:'A current list of all sub-processors is maintained and available', weight:2, severity:'high', article:'Art. 28(2)', risk:'Not knowing who processes data on your behalf means you cannot ensure their compliance.', gate:null },
    { id:'vt3', cat:'vendors', text:'International data transfers rely on an approved safeguard (SCCs, adequacy decision, or BCRs)', weight:3, severity:'critical', article:'Art. 46', risk:'Transfers without a safeguard are unlawful since the Schrems II ruling invalidated Privacy Shield.', gate:null },
    { id:'vt4', cat:'vendors', text:'Transfer impact assessments have been completed for third-country recipients', weight:2, severity:'high', article:'Art. 44', risk:'Post-Schrems II, regulators expect a documented assessment of recipient-country protections.', gate:null },

    // Documentation
    { id:'dc1', cat:'documentation', text:'A Record of Processing Activities (ROPA) is maintained', weight:2, severity:'high', article:'Art. 30', risk:'Supervisory authorities request the ROPA as a first step in most audits.', gate:'ropa' },
    { id:'dc2', cat:'documentation', text:'A Data Protection Officer has been appointed', weight:2, severity:'high', article:'Art. 37', risk:'Organisations required to appoint a DPO that fail to do so face enforcement action.', gate:'dpo' },
    { id:'dc3', cat:'documentation', text:'Data Protection Impact Assessments are conducted for high-risk processing activities', weight:2, severity:'high', article:'Art. 35', risk:'High-risk processing without a DPIA may be ordered to stop by a supervisory authority.', gate:null },
    { id:'dc4', cat:'documentation', text:'Data protection practices are reviewed and updated at least annually', weight:1, severity:'medium', article:'Art. 5(2)', risk:'Stale policies that no longer reflect actual practices create compliance gaps over time.', gate:null },
    { id:'dc5', cat:'documentation', text:'Staff who handle personal data receive data protection training', weight:1, severity:'medium', article:'Art. 39(1)(b)', risk:'Untrained staff are the leading cause of accidental data breaches.', gate:null }
  ];

  var categories = [
    { id:'lawful-basis', name:'Lawful Basis' },
    { id:'transparency', name:'Transparency' },
    { id:'data-rights', name:'Data Subject Rights' },
    { id:'security', name:'Security' },
    { id:'vendors', name:'Vendors and Transfers' },
    { id:'documentation', name:'Documentation' }
  ];

  var severityOrder = { critical:0, high:1, medium:2 };

  /* ========== STATE ========== */
  var context = { based:'', headcount:'', serveEU:false, specialCategory:false };
  var answers = {}; // itemId -> 'yes'|'partial'|'no'

  /* ========== DOM REFS ========== */
  var basedSelect = document.getElementById('ctx-based');
  var headcountSelect = document.getElementById('ctx-headcount');
  var sectionsDiv = document.getElementById('checklist-sections');
  var scoreBtn = document.getElementById('score-btn');
  var resultsDiv = document.getElementById('results');
  var formDiv = document.getElementById('tool-form');
  var ringProgress = document.getElementById('ring-progress');
  var ringLabel = document.getElementById('ring-label');
  var scoreVerdict = document.getElementById('score-verdict');
  var sectionBars = document.getElementById('section-bars');
  var failedItemsWrap = document.getElementById('failed-items-wrap');
  var failedItemsDiv = document.getElementById('failed-items');
  var copyBtn = document.getElementById('copy-btn');
  var printBtn = document.getElementById('print-btn');
  var editBtn = document.getElementById('edit-btn');

  /* ========== RESTORE FROM LOCALSTORAGE ========== */
  try {
    var saved = localStorage.getItem('gdpr_checklist_context');
    if (saved) {
      var parsed = JSON.parse(saved);
      context.based = parsed.based || '';
      context.headcount = parsed.headcount || '';
      context.serveEU = !!parsed.serveEU;
      context.specialCategory = !!parsed.specialCategory;
      if (context.based) basedSelect.value = context.based;
      if (context.headcount) headcountSelect.value = context.headcount;
    }
    var savedAnswers = localStorage.getItem('gdpr_checklist_answers');
    if (savedAnswers) answers = JSON.parse(savedAnswers);
  } catch(e) {}

  /* ========== RENDER CHECKLIST ========== */
  function renderChecklist() {
    sectionsDiv.innerHTML = '';
    categories.forEach(function(cat) {
      var catItems = items.filter(function(it) { return it.cat === cat.id; });
      var section = document.createElement('div');
      section.className = 'checklist-section';
      section.setAttribute('data-cat', cat.id);

      var heading = document.createElement('h2');
      heading.className = 'section-title';
      heading.textContent = cat.name;
      section.appendChild(heading);

      catItems.forEach(function(item) {
        var row = document.createElement('div');
        row.className = 'checklist-item';
        row.setAttribute('data-id', item.id);
        if (item.gate) row.setAttribute('data-gate', item.gate);

        var label = document.createElement('span');
        label.className = 'item-label';
        label.textContent = item.text;

        var badge = document.createElement('span');
        badge.className = 'severity-badge severity-' + item.severity;
        badge.textContent = item.severity;

        var articleTag = document.createElement('span');
        articleTag.className = 'article-tag';
        articleTag.textContent = item.article;

        var meta = document.createElement('div');
        meta.className = 'item-meta';
        meta.appendChild(badge);
        meta.appendChild(articleTag);

        var toggleWrap = document.createElement('div');
        toggleWrap.className = 'item-toggle';

        var vals = ['yes','partial','no'];
        var labels = ['Yes','Partial','No'];
        vals.forEach(function(v, i) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'toggle-btn toggle-' + v;
          if (answers[item.id] === v) btn.classList.add('active');
          btn.setAttribute('data-item', item.id);
          btn.setAttribute('data-value', v);
          btn.textContent = labels[i];
          btn.addEventListener('click', function() {
            var wrap = this.parentElement;
            wrap.querySelectorAll('.toggle-btn').forEach(function(b) { b.classList.remove('active'); });
            this.classList.add('active');
            answers[item.id] = v;
            saveState();
            updateScoreBtn();
          });
          toggleWrap.appendChild(btn);
        });

        row.appendChild(label);
        row.appendChild(meta);
        row.appendChild(toggleWrap);
        section.appendChild(row);
      });

      sectionsDiv.appendChild(section);
    });

    updateGating();
    updateScoreBtn();
    restoreToggles();
  }

  function restoreToggles() {
    // Restore context toggles
    if (context.serveEU) {
      document.querySelector('[data-field="serveEU"][data-value="yes"]').classList.add('active');
      document.querySelector('[data-field="serveEU"][data-value="no"]').classList.remove('active');
    }
    if (context.specialCategory) {
      document.querySelector('[data-field="specialCategory"][data-value="yes"]').classList.add('active');
      document.querySelector('[data-field="specialCategory"][data-value="no"]').classList.remove('active');
    }
  }

  /* ========== GATING ========== */
  function isGated(item) {
    if (!item.gate) return false;
    if (item.gate === 'specialCategory') return !context.specialCategory;
    if (item.gate === 'ropa') return !(context.headcount === '250+' || context.specialCategory);
    if (item.gate === 'dpo') return !context.specialCategory;
    return false;
  }

  function updateGating() {
    items.forEach(function(item) {
      var row = document.querySelector('[data-id="' + item.id + '"]');
      if (!row) return;
      if (isGated(item)) {
        row.style.display = 'none';
      } else {
        row.style.display = '';
      }
    });
  }

  /* ========== CONTEXT HANDLERS ========== */
  basedSelect.addEventListener('change', function() {
    context.based = this.value;
    saveState();
    updateScoreBtn();
  });
  headcountSelect.addEventListener('change', function() {
    context.headcount = this.value;
    updateGating();
    saveState();
    updateScoreBtn();
  });

  document.querySelectorAll('#context-toggles .toggle-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var field = this.getAttribute('data-field');
      var value = this.getAttribute('data-value');
      var wrap = this.parentElement;
      wrap.querySelectorAll('.toggle-btn').forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
      context[field] = value === 'yes';
      updateGating();
      saveState();
      updateScoreBtn();
    });
  });

  /* ========== SCORE BUTTON STATE ========== */
  function updateScoreBtn() {
    scoreBtn.disabled = !(context.based && context.headcount);
  }

  /* ========== SCORING ========== */
  function getApplicableItems() {
    return items.filter(function(item) { return !isGated(item); });
  }

  function calcScore(subset) {
    var totalWeight = 0;
    var earnedWeight = 0;
    subset.forEach(function(item) {
      totalWeight += item.weight;
      var ans = answers[item.id];
      if (ans === 'yes') earnedWeight += item.weight;
      else if (ans === 'partial') earnedWeight += item.weight * 0.5;
    });
    return totalWeight > 0 ? Math.round((earnedWeight / totalWeight) * 100) : 0;
  }

  /* ========== RENDER RESULTS ========== */
  scoreBtn.addEventListener('click', function() {
    var applicable = getApplicableItems();
    var overall = calcScore(applicable);

    // Animate ring
    var circumference = 2 * Math.PI * 52; // 326.73
    var offset = circumference - (overall / 100) * circumference;
    ringProgress.style.transition = 'stroke-dashoffset 1s ease';
    ringProgress.style.strokeDashoffset = offset;
    if (overall >= 80) ringProgress.style.stroke = '#16A34A';
    else if (overall >= 50) ringProgress.style.stroke = '#F59E0B';
    else ringProgress.style.stroke = '#EF4444';
    ringLabel.textContent = overall + '%';

    // Verdict
    if (overall >= 90) scoreVerdict.textContent = 'Strong compliance posture. Address any remaining gaps to reach full readiness.';
    else if (overall >= 70) scoreVerdict.textContent = 'Good foundation, but several areas need attention before you can demonstrate full compliance.';
    else if (overall >= 50) scoreVerdict.textContent = 'Significant gaps exist. Prioritise the critical items listed below to reduce enforcement risk.';
    else scoreVerdict.textContent = 'Major compliance gaps detected. Immediate action on the critical items below is strongly recommended.';

    // Section bars
    sectionBars.innerHTML = '';
    categories.forEach(function(cat) {
      var catItems = applicable.filter(function(it) { return it.cat === cat.id; });
      if (catItems.length === 0) return;
      var pct = calcScore(catItems);

      var bar = document.createElement('div');
      bar.className = 'bar-row';

      var label = document.createElement('span');
      label.className = 'bar-label';
      label.textContent = cat.name;

      var track = document.createElement('div');
      track.className = 'bar-track';
      var fill = document.createElement('div');
      fill.className = 'bar-fill';
      fill.style.width = pct + '%';
      if (pct >= 80) fill.style.background = '#16A34A';
      else if (pct >= 50) fill.style.background = '#F59E0B';
      else fill.style.background = '#EF4444';
      track.appendChild(fill);

      var pctLabel = document.createElement('span');
      pctLabel.className = 'bar-pct';
      pctLabel.textContent = pct + '%';

      bar.appendChild(label);
      bar.appendChild(track);
      bar.appendChild(pctLabel);
      sectionBars.appendChild(bar);
    });

    // Failed items
    var failed = applicable.filter(function(it) {
      var ans = answers[it.id];
      return ans !== 'yes';
    });
    failed.sort(function(a, b) {
      var sd = severityOrder[a.severity] - severityOrder[b.severity];
      if (sd !== 0) return sd;
      return b.weight - a.weight;
    });

    failedItemsDiv.innerHTML = '';
    if (failed.length > 0) {
      failedItemsWrap.style.display = '';
      failed.forEach(function(item) {
        var card = document.createElement('div');
        card.className = 'failed-card';

        var header = document.createElement('div');
        header.className = 'failed-header';

        var badge = document.createElement('span');
        badge.className = 'severity-badge severity-' + item.severity;
        badge.textContent = item.severity;

        var articleTag = document.createElement('span');
        articleTag.className = 'article-tag';
        articleTag.textContent = item.article;

        var ansTag = document.createElement('span');
        ansTag.className = 'answer-tag answer-' + (answers[item.id] || 'no');
        ansTag.textContent = answers[item.id] === 'partial' ? 'Partial' : 'No';

        header.appendChild(badge);
        header.appendChild(articleTag);
        header.appendChild(ansTag);

        var title = document.createElement('p');
        title.className = 'failed-title';
        title.textContent = item.text;

        var risk = document.createElement('p');
        risk.className = 'failed-risk';
        risk.textContent = item.risk;

        card.appendChild(header);
        card.appendChild(title);
        card.appendChild(risk);
        failedItemsDiv.appendChild(card);
      });
    } else {
      failedItemsWrap.style.display = 'none';
    }

    formDiv.style.display = 'none';
    resultsDiv.style.display = 'block';

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'tool_complete', score: overall });

    resultsDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  /* ========== COPY SUMMARY ========== */
  copyBtn.addEventListener('click', function() {
    var applicable = getApplicableItems();
    var overall = calcScore(applicable);
    var lines = [];
    lines.push('GDPR Compliance Readiness Report');
    lines.push('Generated: ' + new Date().toLocaleDateString());
    lines.push('Overall Score: ' + overall + '%');
    lines.push('');
    lines.push('Company Context:');
    lines.push('  Based in: ' + (context.based || 'Not set'));
    lines.push('  Serves EU residents: ' + (context.serveEU ? 'Yes' : 'No'));
    lines.push('  Headcount: ' + (context.headcount || 'Not set'));
    lines.push('  Special-category data: ' + (context.specialCategory ? 'Yes' : 'No'));
    lines.push('');
    lines.push('Section Scores:');
    categories.forEach(function(cat) {
      var catItems = applicable.filter(function(it) { return it.cat === cat.id; });
      if (catItems.length === 0) return;
      lines.push('  ' + cat.name + ': ' + calcScore(catItems) + '%');
    });

    var failed = applicable.filter(function(it) { return answers[it.id] !== 'yes'; });
    failed.sort(function(a, b) {
      var sd = severityOrder[a.severity] - severityOrder[b.severity];
      if (sd !== 0) return sd;
      return b.weight - a.weight;
    });
    if (failed.length > 0) {
      lines.push('');
      lines.push('Items Needing Attention:');
      failed.forEach(function(item, i) {
        var status = answers[item.id] === 'partial' ? 'PARTIAL' : 'MISSING';
        lines.push('  ' + (i + 1) + '. [' + item.severity.toUpperCase() + '] [' + status + '] ' + item.text + ' (' + item.article + ')');
        lines.push('     Risk: ' + item.risk);
      });
    }
    lines.push('');
    lines.push('Generated by BuildPrivacyPolicy.com/tools/gdpr-compliance-checklist/');

    var text = lines.join('\n');
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function() {
        copyBtn.textContent = 'Copied!';
        setTimeout(function() { copyBtn.textContent = 'Copy Summary'; }, 2000);
      });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.left = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      copyBtn.textContent = 'Copied!';
      setTimeout(function() { copyBtn.textContent = 'Copy Summary'; }, 2000);
    }
  });

  /* ========== PRINT ========== */
  printBtn.addEventListener('click', function() {
    window.print();
  });

  /* ========== EDIT / RESET ========== */
  editBtn.addEventListener('click', function() {
    resultsDiv.style.display = 'none';
    formDiv.style.display = '';
    // Reset ring for next run
    ringProgress.style.transition = 'none';
    ringProgress.style.strokeDashoffset = 326.73;
    formDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  /* ========== PERSIST ========== */
  function saveState() {
    try {
      localStorage.setItem('gdpr_checklist_context', JSON.stringify(context));
      localStorage.setItem('gdpr_checklist_answers', JSON.stringify(answers));
    } catch(e) {}
  }

  /* ========== INIT ========== */
  renderChecklist();
});
</script>

</Layout>

