<script>
  document.addEventListener('DOMContentLoaded', function() {
    var policyText = document.getElementById('policy-text');
    var checkBtn = document.getElementById('check-btn');
    var resetBtn = document.getElementById('reset-btn');
    var resultsDiv = document.getElementById('results');
    var resultsList = document.getElementById('results-list');
    var formDiv = document.getElementById('checker-form');
    var scoreSection = document.getElementById('score-section');
    var statsRow = document.getElementById('stats-row');
    var resultCta = document.getElementById('result-cta');
    var childrenSelect = document.getElementById('children-select');

    // Clause definitions: id, label, keyword patterns, which laws require it
    var clauses = [
      {
        id: 'lawful_basis',
        label: 'Lawful basis for processing',
        laws: ['gdpr', 'lgpd'],
        patterns: ['lawful basis', 'legal basis', 'legitimate interest', 'legal ground', 'processing ground', 'basis for processing', 'contractual necessity', 'legal obligation', 'vital interest', 'public interest', 'performance of a contract']
      },
      {
        id: 'data_categories',
        label: 'Categories of data collected',
        laws: ['gdpr', 'ccpa', 'pipeda', 'lgpd', 'coppa'],
        patterns: ['personal data', 'personal information', 'categories of data', 'types of data', 'data we collect', 'information we collect', 'what we collect', 'information you provide', 'automatically collected', 'data you provide', 'categories of personal', 'types of information']
      },
      {
        id: 'retention',
        label: 'Data retention period',
        laws: ['gdpr', 'ccpa', 'pipeda', 'lgpd'],
        patterns: ['retention', 'how long', 'retain your', 'retain personal', 'storage period', 'keep your', 'deletion schedule', 'data retention', 'retained for', 'stored for', 'retention period', 'retain data', 'kept for']
      },
      {
        id: 'third_party',
        label: 'Third-party sharing',
        laws: ['gdpr', 'ccpa', 'pipeda', 'lgpd', 'coppa'],
        patterns: ['third party', 'third-party', 'share your', 'disclose your', 'service provider', 'data processor', 'subprocessor', 'share personal', 'sharing of', 'disclosed to', 'share information', 'vendors', 'partners who']
      },
      {
        id: 'international_transfers',
        label: 'International data transfers',
        laws: ['gdpr', 'lgpd'],
        patterns: ['international transfer', 'cross-border', 'transfer of data', 'data transfer', 'outside the e', 'outside the eu', 'outside the european', 'adequacy decision', 'standard contractual clause', 'transferred to', 'transfer personal', 'transferred outside', 'transfers of personal']
      },
      {
        id: 'user_rights',
        label: 'User rights (access, deletion, portability)',
        laws: ['gdpr', 'ccpa', 'pipeda', 'lgpd', 'coppa'],
        patterns: ['right to access', 'right to delete', 'right to erasure', 'right to rectification', 'right to portability', 'data portability', 'right to correct', 'right to know', 'right to opt', 'subject access request', 'your rights', 'exercise your rights', 'right to restrict', 'right to object', 'rights of data subject', 'request deletion', 'request access']
      },
      {
        id: 'do_not_sell',
        label: '"Do Not Sell or Share" opt-out',
        laws: ['ccpa'],
        patterns: ['do not sell', 'do not share', 'opt out of sale', 'opt-out of the sale', 'sale of personal', 'right to opt out', 'do not sell or share', 'opt out of sharing', 'selling personal', 'sharing personal information']
      },
      {
        id: 'children_data',
        label: "Children's data practices",
        laws: ['coppa'],
        patterns: ['children', 'child', 'under 13', 'under thirteen', 'minor', 'parental consent', 'parent or guardian', 'coppa', "children's privacy", "children's personal", 'verifiable parental', 'directed to children', 'aimed at children']
      },
      {
        id: 'cookies',
        label: 'Cookies and tracking technologies',
        laws: ['gdpr'],
        patterns: ['cookie', 'cookies', 'tracking technolog', 'web beacon', 'pixel tag', 'local storage', 'session storage', 'tracking pixel', 'analytics cookie', 'cookie policy', 'similar technologies']
      },
      {
        id: 'security',
        label: 'Security measures',
        laws: ['gdpr', 'pipeda', 'lgpd'],
        patterns: ['security', 'protect your', 'safeguard', 'encryption', 'encrypted', 'security measure', 'technical and organizational', 'data protection measure', 'secure your', 'security of your', 'protect personal', 'access controls', 'organizational measures']
      },
      {
        id: 'contact',
        label: 'Contact information',
        laws: ['gdpr', 'ccpa', 'pipeda', 'lgpd', 'coppa'],
        patterns: ['contact us', 'contact information', 'email us', 'write to us', 'data protection officer', 'privacy officer', 'dpo', 'reach us', 'questions about', 'privacy inquir', 'privacy concern', 'contact detail', 'send us']
      },
      {
        id: 'effective_date',
        label: 'Effective date',
        laws: ['gdpr', 'ccpa', 'pipeda', 'lgpd', 'coppa'],
        patterns: ['effective date', 'last updated', 'last modified', 'effective as of', 'updated on', 'date of this', 'revision date', 'last revised']
      }
    ];

    // Law display names
    var lawNames = {
      gdpr: 'GDPR',
      ccpa: 'CCPA/CPRA',
      pipeda: 'PIPEDA',
      lgpd: 'LGPD',
      coppa: 'COPPA'
    };

    // Update check button state
    function updateCheckBtn() {
      var hasText = policyText.value.trim().length > 50;
      var hasLaw = document.querySelectorAll('input[name="law"]:checked').length > 0;
      checkBtn.disabled = !(hasText && hasLaw);
    }

    policyText.addEventListener('input', updateCheckBtn);
    document.querySelectorAll('input[name="law"]').forEach(function(cb) {
      cb.addEventListener('change', function() {
        // Auto-check COPPA if children dropdown is Yes
        if (childrenSelect.value === 'yes') {
          var coppaCb = document.querySelector('input[name="law"][value="coppa"]');
          if (coppaCb && !coppaCb.checked) {
            coppaCb.checked = true;
          }
        }
        updateCheckBtn();
      });
    });
    childrenSelect.addEventListener('change', function() {
      if (this.value === 'yes') {
        var coppaCb = document.querySelector('input[name="law"][value="coppa"]');
        if (coppaCb && !coppaCb.checked) {
          coppaCb.checked = true;
          updateCheckBtn();
        }
      }
    });

    // Flesch reading ease
    function countSyllables(word) {
      word = word.toLowerCase().replace(/[^a-z]/g, '');
      if (word.length <= 3) return 1;
      word = word.replace(/(?:[^laeiouy]es|ed|[^laeiouy]e)$/, '');
      word = word.replace(/^y/, '');
      var m = word.match(/[aeiouy]{1,2}/g);
      return m ? m.length : 1;
    }

    function fleschScore(text) {
      var sentences = text.split(/[.!?]+/).filter(function(s) { return s.trim().length > 0; });
      var words = text.split(/\s+/).filter(function(w) { return w.replace(/[^a-zA-Z]/g, '').length > 0; });
      if (sentences.length === 0 || words.length === 0) return 0;
      var totalSyllables = 0;
      words.forEach(function(w) { totalSyllables += countSyllables(w); });
      var score = 206.835 - 1.015 * (words.length / sentences.length) - 84.6 * (totalSyllables / words.length);
      return Math.max(0, Math.min(100, Math.round(score)));
    }

    function readingBand(score) {
      if (score >= 90) return { label: 'Very Easy', color: '#059669' };
      if (score >= 80) return { label: 'Easy', color: '#059669' };
      if (score >= 70) return { label: 'Fairly Easy', color: '#16A34A' };
      if (score >= 60) return { label: 'Standard', color: '#CA8A04' };
      if (score >= 50) return { label: 'Fairly Difficult', color: '#D97706' };
      if (score >= 30) return { label: 'Difficult', color: '#EA580C' };
      return { label: 'Very Difficult', color: '#DC2626' };
    }

    function scoreColor(pct) {
      if (pct >= 80) return '#059669';
      if (pct >= 60) return '#CA8A04';
      if (pct >= 40) return '#D97706';
      return '#DC2626';
    }

    function scoreLabel(pct) {
      if (pct >= 80) return 'Strong coverage';
      if (pct >= 60) return 'Fair coverage';
      if (pct >= 40) return 'Needs improvement';
      return 'Significant gaps';
    }

    // Check button handler
    checkBtn.addEventListener('click', function() {
      var text = policyText.value.trim();
      var lower = text.toLowerCase();
      var selectedLaws = [];
      document.querySelectorAll('input[name="law"]:checked').forEach(function(cb) {
        selectedLaws.push(cb.value);
      });

      // Determine required clauses for selected laws
      var requiredClauses = [];
      clauses.forEach(function(clause) {
        var isRequired = false;
        var requiringLaws = [];
        clause.laws.forEach(function(law) {
          if (selectedLaws.indexOf(law) !== -1) {
            isRequired = true;
            requiringLaws.push(law);
          }
        });
        if (isRequired) {
          requiredClauses.push({
            id: clause.id,
            label: clause.label,
            patterns: clause.patterns,
            requiringLaws: requiringLaws
          });
        }
      });

      // Check each clause
      var matched = 0;
      var clauseResults = [];
      requiredClauses.forEach(function(clause) {
        var found = false;
        for (var i = 0; i < clause.patterns.length; i++) {
          if (lower.indexOf(clause.patterns[i]) !== -1) {
            found = true;
            break;
          }
        }
        if (found) matched++;
        clauseResults.push({
          label: clause.label,
          found: found,
          laws: clause.requiringLaws
        });
      });

      // Calculate score
      var total = requiredClauses.length;
      var pct = total > 0 ? Math.round((matched / total) * 100) : 0;

      // Word count
      var words = text.split(/\s+/).filter(function(w) { return w.length > 0; });
      var wordCount = words.length;

      // Flesch score
      var flesch = fleschScore(text);
      var band = readingBand(flesch);

      // Render score
      var sc = scoreColor(pct);
      scoreSection.innerHTML =
        '<div class="score-ring-wrap">' +
          '<svg class="score-ring" viewBox="0 0 120 120">' +
            '<circle cx="60" cy="60" r="52" fill="none" stroke="#E5E7EB" stroke-width="10"/>' +
            '<circle cx="60" cy="60" r="52" fill="none" stroke="' + sc + '" stroke-width="10" ' +
              'stroke-dasharray="' + (2 * Math.PI * 52) + '" ' +
              'stroke-dashoffset="' + ((1 - pct / 100) * 2 * Math.PI * 52) + '" ' +
              'stroke-linecap="round" transform="rotate(-90 60 60)" />' +
          '</svg>' +
          '<div class="score-number">' + pct + '</div>' +
        '</div>' +
        '<div class="score-meta">' +
          '<span class="score-label" style="color:' + sc + '">' + scoreLabel(pct) + '</span>' +
          '<span class="score-detail">' + matched + ' of ' + total + ' required clauses found</span>' +
        '</div>';

      // Render stats
      statsRow.innerHTML =
        '<div class="stat-card">' +
          '<span class="stat-value">' + wordCount.toLocaleString() + '</span>' +
          '<span class="stat-label">Words</span>' +
        '</div>' +
        '<div class="stat-card">' +
          '<span class="stat-value" style="color:' + band.color + '">' + flesch + '</span>' +
          '<span class="stat-label">Flesch Score &middot; ' + band.label + '</span>' +
        '</div>';

      // Render checklist
      resultsList.innerHTML = '';
      // Sort: missing first, then found
      clauseResults.sort(function(a, b) {
        if (a.found === b.found) return 0;
        return a.found ? 1 : -1;
      });

      clauseResults.forEach(function(r) {
        var lawTags = r.laws.map(function(l) {
          return '<span class="law-tag">' + lawNames[l] + '</span>';
        }).join(' ');

        var card = document.createElement('div');
        card.className = 'clause-card ' + (r.found ? 'clause-pass' : 'clause-missing');
        card.innerHTML =
          '<div class="clause-status">' +
            (r.found
              ? '<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#059669"/><path d="M6 10.5L8.5 13L14 7.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>'
              : '<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#DC2626"/><path d="M7 7L13 13M13 7L7 13" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>') +
          '</div>' +
          '<div class="clause-info">' +
            '<span class="clause-label">' + r.label + '</span>' +
            '<span class="clause-status-text">' + (r.found ? 'Found' : 'Missing') + '</span>' +
          '</div>' +
          '<div class="clause-laws">' + lawTags + '</div>';

        resultsList.appendChild(card);
      });

      // CTA
      var missing = total - matched;
      if (missing > 0) {
        resultCta.innerHTML =
          '<p>Your policy is missing ' + missing + ' required clause' + (missing > 1 ? 's' : '') + '. ' +
          'You can <a href="/">generate a complete privacy policy</a> that covers every disclosure automatically, or ' +
          '<a href="/resources/how-to-write-privacy-policy-for-app/">read our guide</a> to add the missing sections yourself.</p>';
      } else {
        resultCta.innerHTML =
          '<p>Your policy covers all required clauses for the selected laws. Consider having a qualified attorney review the wording to confirm accuracy. ' +
          'If you need to update your policy later, you can always <a href="/">regenerate it</a> with the latest requirements.</p>';
      }

      formDiv.style.display = 'none';
      resultsDiv.style.display = 'block';

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'tool_complete', score: pct, clauses_matched: matched, clauses_total: total });

      resultsDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    // Reset
    resetBtn.addEventListener('click', function() {
      policyText.value = '';
      document.querySelectorAll('input[name="law"]').forEach(function(cb) { cb.checked = false; });
      childrenSelect.value = 'no';
      checkBtn.disabled = true;
      resultsDiv.style.display = 'none';
      formDiv.style.display = 'block';
      scoreSection.innerHTML = '';
      statsRow.innerHTML = '';
      resultsList.innerHTML = '';
      resultCta.innerHTML = '';
      formDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

</Layout>

