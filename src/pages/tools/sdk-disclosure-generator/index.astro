        dataCategories: ['Device identifiers', 'Usage data', 'IP address', 'Browser/OS information'],
        purpose: 'to measure app usage, track user interactions, and generate audience reports',
        policyUrl: 'https://policies.google.com/privacy'
      },
      firebase_analytics: {
        name: 'Firebase Analytics',
        vendor: 'Google LLC',
        dataCategories: ['Device identifiers', 'Usage data', 'App instance identifiers', 'Advertising identifiers'],
        purpose: 'to collect app usage and behavior data, measure conversions, and generate analytics reports',
        policyUrl: 'https://firebase.google.com/support/privacy'
      },
      mixpanel: {
        name: 'Mixpanel',
        vendor: 'Mixpanel Inc.',
        dataCategories: ['Device identifiers', 'Usage data', 'IP address', 'User interactions'],
        purpose: 'to track user events, analyze product usage patterns, and build behavioral analytics reports',
        policyUrl: 'https://mixpanel.com/legal/privacy-policy/'
      },
      amplitude: {
        name: 'Amplitude',
        vendor: 'Amplitude Inc.',
        dataCategories: ['Device identifiers', 'Usage data', 'IP address', 'Session data'],
        purpose: 'to analyze user behavior, measure feature adoption, and generate product analytics',
        policyUrl: 'https://amplitude.com/privacy'
      },
      admob: {
        name: 'Google AdMob',
        vendor: 'Google LLC',
        dataCategories: ['Advertising identifiers', 'Device identifiers', 'IP address', 'Usage data', 'Location (coarse)'],
        purpose: 'to display personalized or non-personalized advertisements within the app',
        policyUrl: 'https://policies.google.com/privacy'
      },
      meta_audience_network: {
        name: 'Meta Audience Network',
        vendor: 'Meta Platforms Inc.',
        dataCategories: ['Advertising identifiers', 'Device identifiers', 'IP address', 'Usage data', 'Interaction data'],
        purpose: 'to serve targeted advertisements and measure ad performance within the app',
        policyUrl: 'https://www.facebook.com/privacy/policy/'
      },
      sentry: {
        name: 'Sentry',
        vendor: 'Functional Software Inc.',
        dataCategories: ['Device identifiers', 'OS and device information', 'Crash logs', 'Stack traces', 'IP address'],
        purpose: 'to capture, report, and diagnose application errors and crashes in real time',
        policyUrl: 'https://sentry.io/privacy/'
      },
      crashlytics: {
        name: 'Firebase Crashlytics',
        vendor: 'Google LLC',
        dataCategories: ['Crash logs', 'Device identifiers', 'OS and device information', 'Stack traces', 'App state data'],
        purpose: 'to collect crash reports, diagnose stability issues, and prioritize bug fixes',
        policyUrl: 'https://firebase.google.com/support/privacy'
      },
      stripe: {
        name: 'Stripe',
        vendor: 'Stripe Inc.',
        dataCategories: ['Payment card details', 'Transaction data', 'Billing address', 'IP address', 'Device identifiers'],
        purpose: 'to process payments, prevent fraud, and manage billing and subscriptions',
        policyUrl: 'https://stripe.com/privacy'
      },
      paypal: {
        name: 'PayPal',
        vendor: 'PayPal Holdings Inc.',
        dataCategories: ['Payment information', 'Transaction data', 'Account information', 'IP address', 'Device identifiers'],
        purpose: 'to process payments and manage financial transactions within the app',
        policyUrl: 'https://www.paypal.com/webapps/mpp/ua/privacy-full'
      },
      revenuecat: {
        name: 'RevenueCat',
        vendor: 'RevenueCat Inc.',
        dataCategories: ['Purchase history', 'Subscription status', 'Device identifiers', 'App user identifiers'],
        purpose: 'to manage in-app subscriptions, track purchase events, and synchronize entitlement status across platforms',
        policyUrl: 'https://www.revenuecat.com/privacy/'
      },
      firebase_auth: {
        name: 'Firebase Authentication',
        vendor: 'Google LLC',
        dataCategories: ['Email address', 'Phone number', 'User identifiers', 'IP address', 'User agent'],
        purpose: 'to authenticate users, manage sign-in sessions, and handle account creation and recovery',
        policyUrl: 'https://firebase.google.com/support/privacy'
      },
      auth0: {
        name: 'Auth0',
        vendor: 'Okta Inc.',
        dataCategories: ['Email address', 'User identifiers', 'IP address', 'Login metadata', 'User agent'],
        purpose: 'to provide user authentication, manage identity tokens, and enforce access control',
        policyUrl: 'https://auth0.com/privacy'
      },
      google_sign_in: {
        name: 'Google Sign-In',
        vendor: 'Google LLC',
        dataCategories: ['Email address', 'Name', 'Profile picture URL', 'User identifiers'],
        purpose: 'to let users sign in with their Google account and retrieve basic profile information',
        policyUrl: 'https://policies.google.com/privacy'
      },
      apple_sign_in: {
        name: 'Sign in with Apple',
        vendor: 'Apple Inc.',
        dataCategories: ['Email address (or relay address)', 'Name', 'User identifiers'],
        purpose: 'to let users sign in with their Apple ID, optionally hiding their real email address',
        policyUrl: 'https://www.apple.com/legal/privacy/'
      },
      onesignal: {
        name: 'OneSignal',
        vendor: 'OneSignal Inc.',
        dataCategories: ['Device identifiers', 'Push notification tokens', 'IP address', 'Usage data', 'Language and timezone'],
        purpose: 'to send push notifications, segment users, and track notification delivery and engagement',
        policyUrl: 'https://onesignal.com/privacy_policy'
      },
      fcm: {
        name: 'Firebase Cloud Messaging',
        vendor: 'Google LLC',
        dataCategories: ['Device identifiers', 'Push notification tokens', 'App instance identifiers'],
        purpose: 'to deliver push notifications and data messages to user devices',
        policyUrl: 'https://firebase.google.com/support/privacy'
      },
      intercom: {
        name: 'Intercom',
        vendor: 'Intercom Inc.',
        dataCategories: ['Email address', 'Name', 'User identifiers', 'Usage data', 'Conversation content', 'IP address'],
        purpose: 'to provide in-app customer support chat, help center access, and user engagement messaging',
        policyUrl: 'https://www.intercom.com/legal/privacy'
      },
      crisp: {
        name: 'Crisp',
        vendor: 'Crisp IM SAS',
        dataCategories: ['Email address', 'Name', 'User identifiers', 'Conversation content', 'IP address', 'Browser/OS information'],
        purpose: 'to provide live chat support, manage help desk conversations, and track customer interactions',
        policyUrl: 'https://crisp.chat/en/privacy/'
      },
      zendesk: {
        name: 'Zendesk',
        vendor: 'Zendesk Inc.',
        dataCategories: ['Email address', 'Name', 'User identifiers', 'Support ticket content', 'IP address', 'Device information'],
        purpose: 'to manage customer support tickets, provide in-app help center access, and track support interactions',
        policyUrl: 'https://www.zendesk.com/company/agreements-and-terms/privacy-policy/'
      },
      supabase: {
        name: 'Supabase',
        vendor: 'Supabase Inc.',
        dataCategories: ['User identifiers', 'Email address', 'Authentication tokens', 'Application data', 'IP address'],
        purpose: 'to provide backend database storage, user authentication, and real-time data synchronization',
        policyUrl: 'https://supabase.com/privacy'
      },
      aws_amplify: {
        name: 'AWS Amplify',
        vendor: 'Amazon Web Services Inc.',
        dataCategories: ['User identifiers', 'Authentication tokens', 'Application data', 'IP address', 'Usage metadata'],
        purpose: 'to provide backend services including authentication, data storage, and API hosting',
        policyUrl: 'https://aws.amazon.com/privacy/'
      },
      cloudflare: {
        name: 'Cloudflare',
        vendor: 'Cloudflare Inc.',
        dataCategories: ['IP address', 'HTTP request metadata', 'Browser/OS information', 'Performance data'],
        purpose: 'to provide content delivery, DNS resolution, DDoS protection, and web performance optimization',
        policyUrl: 'https://www.cloudflare.com/privacypolicy/'
      }
    };

    /* ───── STATE ───── */

    var selectedSdks = {};

    /* ───── DOM REFS ───── */

    var generateBtn = document.getElementById('generate-btn');
    var resetBtn = document.getElementById('reset-btn');
    var resultsDiv = document.getElementById('results');
    var formDiv = document.getElementById('sdk-form');
    var appNameInput = document.getElementById('app-name');
    var disclosureText = document.getElementById('disclosure-text');
    var dataCategoriesTable = document.getElementById('data-categories-table');
    var copyDisclosureBtn = document.getElementById('copy-disclosure-btn');

    /* ───── CHIP TOGGLE HANDLERS ───── */

    document.querySelectorAll('.chip[data-sdk]').forEach(function(chip) {
      chip.addEventListener('click', function() {
        var key = this.getAttribute('data-sdk');
        if (selectedSdks[key]) {
          delete selectedSdks[key];
          this.classList.remove('active');
        } else {
          selectedSdks[key] = true;
          this.classList.add('active');
        }
        updateGenerateBtn();
      });
    });

    function updateGenerateBtn() {
      generateBtn.disabled = Object.keys(selectedSdks).length === 0;
    }

    /* ───── GENERATE BUTTON ───── */

    generateBtn.addEventListener('click', function() {
      var sdkKeys = Object.keys(selectedSdks);
      var appName = appNameInput.value.trim() || 'Our application';

      /* Build disclosure paragraphs */
      var paras = [];
      paras.push('<p><strong>Third-Party Services</strong></p>');
      paras.push('<p>' + appName + ' uses the following third-party services that may collect and process user data. Each service operates under its own privacy policy, which governs its handling of your information.</p>');

      sdkKeys.forEach(function(key) {
        var sdk = SDK_DATA[key];
        var dataList = sdk.dataCategories.join(', ').toLowerCase();
        paras.push('<p><strong>' + sdk.name + '</strong> (provided by ' + sdk.vendor + '). We use ' + sdk.name + ' ' + sdk.purpose + '. This service may collect ' + dataList + '. For more information, see the <a href="' + sdk.policyUrl + '" rel="nofollow">' + sdk.vendor + ' Privacy Policy</a>.</p>');
      });

      disclosureText.innerHTML = paras.join('\n');

      /* Build deduplicated data categories table */
      var categoryMap = {};
      sdkKeys.forEach(function(key) {
        var sdk = SDK_DATA[key];
        sdk.dataCategories.forEach(function(cat) {
          if (!categoryMap[cat]) {
            categoryMap[cat] = [];
          }
          if (categoryMap[cat].indexOf(sdk.name) === -1) {
            categoryMap[cat].push(sdk.name);
          }
        });
      });

      var catKeys = Object.keys(categoryMap).sort();
      var tableHtml = '<table class="data-table"><thead><tr><th>Data Category</th><th>Collected By</th></tr></thead><tbody>';
      catKeys.forEach(function(cat) {
        tableHtml += '<tr><td>' + cat + '</td><td>' + categoryMap[cat].join(', ') + '</td></tr>';
      });
      tableHtml += '</tbody></table>';
      dataCategoriesTable.innerHTML = tableHtml;

      formDiv.style.display = 'none';
      resultsDiv.style.display = 'block';

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'tool_complete', tool: 'sdk_disclosure', sdks_selected: sdkKeys.length });

      resultsDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    /* ───── COPY BUTTON ───── */

    copyDisclosureBtn.addEventListener('click', function() {
      var el = document.getElementById('disclosure-text');
      if (!el) return;
      var text = el.innerText;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function() {
          showCopyConfirm();
        });
      } else {
        var textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        showCopyConfirm();
      }
    });

    function showCopyConfirm() {
      copyDisclosureBtn.textContent = 'Copied!';
      setTimeout(function() { copyDisclosureBtn.textContent = 'Copy to clipboard'; }, 2000);
    }

    /* ───── RESET ───── */

    resetBtn.addEventListener('click', function() {
      selectedSdks = {};
      appNameInput.value = '';
      document.querySelectorAll('.chip').forEach(function(c) { c.classList.remove('active'); });
      generateBtn.disabled = true;
      resultsDiv.style.display = 'none';
      formDiv.style.display = 'block';
      formDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

</Layout>

