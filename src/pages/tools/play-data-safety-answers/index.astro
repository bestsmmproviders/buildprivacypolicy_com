<script>
  document.addEventListener('DOMContentLoaded', function() {

    /* ───── PLAY DATA SAFETY CATEGORIES (snapshot October 2026) ───── */

    var DATA_CATEGORIES = {
      "Location": [
        { id: "approximate_location", label: "Approximate location", desc: "City-level or area within 3 square kilometers" },
        { id: "precise_location", label: "Precise location", desc: "Exact coordinates (GPS, Wi-Fi, cell tower)" }
      ],
      "Personal info": [
        { id: "name", label: "Name", desc: "First or last name, nickname" },
        { id: "email_address", label: "Email address", desc: "Including hashed or encrypted email" },
        { id: "user_ids", label: "User IDs", desc: "Screen name, account ID, account number, or other user-level ID" },
        { id: "address", label: "Address", desc: "Mailing or home address" },
        { id: "phone_number", label: "Phone number", desc: "Phone number" },
        { id: "race_ethnicity", label: "Race and ethnicity", desc: "Racial or ethnic information" },
        { id: "political_religious", label: "Political or religious beliefs", desc: "Political or religious views" },
        { id: "sexual_orientation", label: "Sexual orientation", desc: "Sexual orientation information" },
        { id: "other_personal_info", label: "Other personal info", desc: "Any other personal information such as date of birth, gender, or veteran status" }
      ],
      "Financial info": [
        { id: "user_payment_info", label: "User payment info", desc: "Credit card number, bank account number, or other financial account info" },
        { id: "purchase_history", label: "Purchase history", desc: "Information about purchases the user has made" },
        { id: "credit_score", label: "Credit score", desc: "User's credit score" },
        { id: "other_financial_info", label: "Other financial info", desc: "Salary, debts, or any other financial information" }
      ],
      "Health and fitness": [
        { id: "health_info", label: "Health information", desc: "Medical records, health conditions, clinical data" },
        { id: "fitness_info", label: "Fitness information", desc: "Exercise or fitness activity data" }
      ],
      "Messages": [
        { id: "emails", label: "Emails", desc: "Email content including subject, sender, recipients, body" },
        { id: "sms_mms", label: "SMS or MMS", desc: "Text or multimedia message content" },
        { id: "other_messages", label: "Other in-app messages", desc: "Other message types such as instant messages or chat content" }
      ],
      "Photos and videos": [
        { id: "photos", label: "Photos", desc: "User's photos" },
        { id: "videos", label: "Videos", desc: "User's videos" }
      ],
      "Audio files": [
        { id: "voice_recordings", label: "Voice or sound recordings", desc: "User's voice or audio recordings" },
        { id: "music_files", label: "Music files", desc: "User's music files" },
        { id: "other_audio", label: "Other audio files", desc: "Any other audio files created by or provided by the user" }
      ],
      "Files and docs": [
        { id: "files_docs", label: "Files and docs", desc: "User's files or documents, or information about their files or documents such as file names" }
      ],
      "Calendar": [
        { id: "calendar_events", label: "Calendar events", desc: "Information from the user's calendar such as events, notes, and attendees" }
      ],
      "Contacts": [
        { id: "contacts", label: "Contacts", desc: "User's contact list or address book, including contact names, message history, social graph information" }
      ],
      "App activity": [
        { id: "app_interactions", label: "App interactions", desc: "Information about how the user interacts with the app (pages visited, taps, features used)" },
        { id: "in_app_search_history", label: "In-app search history", desc: "What the user has searched for in your app" },
        { id: "installed_apps", label: "Installed apps", desc: "List of apps installed on the user's device" },
        { id: "other_user_content", label: "Other user-generated content", desc: "Any other content created by the user (bios, notes, responses)" },
        { id: "other_actions", label: "Other actions", desc: "Any other user activity not listed here, such as gameplay or dialog options" }
      ],
      "Web browsing": [
        { id: "web_browsing_history", label: "Web browsing history", desc: "List of web pages the user has visited" }
      ],
      "App info and performance": [
        { id: "crash_logs", label: "Crash logs", desc: "Crash data from the app" },
        { id: "diagnostics", label: "Diagnostics", desc: "Performance data such as battery, loading time, latency, framerate, or diagnostics" },
        { id: "other_app_performance", label: "Other app performance data", desc: "Any other data related to app performance not listed here" }
      ],
      "Device or other IDs": [
        { id: "device_ids", label: "Device or other IDs", desc: "Device identifiers such as IMEI, MAC address, Widevine ID, Firebase ID, or advertising identifier" }
      ]
    };

    var PURPOSES = [
      "App functionality",
      "Analytics",
      "Developer communications",
      "Advertising or marketing",
      "Fraud prevention, security, and compliance",
      "Personalization",
      "Account management"
    ];

    /* ───── WARNING RULES ───── */

    function checkWarnings(selections) {
      var warnings = [];

      selections.forEach(function(s) {
        /* Shared with no purpose */
        if (s.shared && !s.purpose) {
          warnings.push({ severity: 'error', msg: '<strong>' + s.label + '</strong>: marked as shared but no purpose selected. Play Console requires a purpose for every shared data type.' });
        }
        /* Collected with no purpose */
        if (s.collected && !s.purpose) {
          warnings.push({ severity: 'error', msg: '<strong>' + s.label + '</strong>: marked as collected but no purpose selected. Play Console requires a purpose for every collected data type.' });
        }
      });

      /* Location with no in-app disclosure warning */
      var hasLocation = selections.some(function(s) {
        return (s.id === 'precise_location' || s.id === 'approximate_location') && (s.collected || s.shared);
      });
      if (hasLocation) {
        warnings.push({ severity: 'warning', msg: '<strong>Location data</strong>: Google requires a prominent in-app disclosure before collecting location data. Make sure your app shows a clear disclosure screen before requesting location permissions.' });
      }

      /* Advertising ID shared without advertising purpose */
      var hasDeviceIdShared = selections.some(function(s) {
        return s.id === 'device_ids' && s.shared;
      });
      var hasAdPurpose = selections.some(function(s) {
        return s.id === 'device_ids' && s.purpose === 'Advertising or marketing';
      });
      if (hasDeviceIdShared && !hasAdPurpose) {
        warnings.push({ severity: 'warning', msg: '<strong>Device IDs shared</strong>: you are sharing device identifiers but did not select "Advertising or marketing" as the purpose. If any ad SDK reads the advertising ID, this purpose should be declared.' });
      }

      /* Sensitive data types that need careful handling */
      var sensitiveTypes = ['race_ethnicity', 'political_religious', 'sexual_orientation', 'health_info'];
      selections.forEach(function(s) {
        if (sensitiveTypes.indexOf(s.id) !== -1 && (s.collected || s.shared)) {
          warnings.push({ severity: 'warning', msg: '<strong>' + s.label + '</strong> is a sensitive data type. Google may require additional review. Make sure you have explicit user consent and a clear purpose for collecting this data.' });
        }
      });

      /* Not encrypted in transit */
      var encrypted = document.getElementById('encrypted-transit').checked;
      if (!encrypted) {
        warnings.push({ severity: 'error', msg: '<strong>Data not encrypted in transit</strong>: Google expects all data transmitted from the device to be encrypted. Not encrypting data in transit will be flagged during review and displayed prominently on your store listing.' });
      }

      /* No deletion mechanism */
      var deletable = document.getElementById('deletion-request').checked;
      if (!deletable && selections.length > 0) {
        warnings.push({ severity: 'warning', msg: '<strong>No deletion mechanism</strong>: users cannot request deletion of their data. While not strictly required for all data types, Google recommends providing a deletion path. Lack of a deletion option is displayed on your store listing.' });
      }

      return warnings;
    }

    /* ───── STATE ───── */

    var selectedTypes = {};

    /* ───── DOM REFS ───── */

    var generateBtn = document.getElementById('generate-btn');
    var resetBtn = document.getElementById('reset-btn');
    var resultsDiv = document.getElementById('results');
    var formDiv = document.getElementById('data-safety-form');
    var declarationsText = document.getElementById('declarations-text');
    var copyBtn = document.getElementById('copy-btn');
    var warningsContainer = document.getElementById('warnings-container');
    var warningsBox = document.getElementById('warnings-box');
    var summaryTableContainer = document.getElementById('summary-table-container');
    var categorySections = document.getElementById('category-sections');
    var dataTypeSections = document.getElementById('data-type-sections');

    /* ───── BUILD FORM ───── */

    function buildCategorySections() {
      var html = '';
      var catKeys = Object.keys(DATA_CATEGORIES);

      catKeys.forEach(function(catName) {
        var types = DATA_CATEGORIES[catName];
        html += '<div class="data-category">';
        html += '<h2 class="category-label">' + catName + '</h2>';

        types.forEach(function(dt) {
          html += '<div class="data-type-row">';
          html += '<label class="checkbox-label dt-check"><input type="checkbox" class="dt-checkbox" data-id="' + dt.id + '" data-label="' + dt.label + '" /> ' + dt.label + '</label>';
          html += '<span class="dt-desc">' + dt.desc + '</span>';

          html += '<div class="dt-options" id="opts-' + dt.id + '" style="display:none;">';

          /* Collected / Shared */
          html += '<div class="opt-row"><span class="opt-label">How is this data handled?</span>';
          html += '<label class="checkbox-label small"><input type="checkbox" class="dt-collected" data-id="' + dt.id + '" /> Collected</label>';
          html += '<label class="checkbox-label small"><input type="checkbox" class="dt-shared" data-id="' + dt.id + '" /> Shared with third parties</label>';
          html += '</div>';

          /* Purpose */
          html += '<div class="opt-row"><span class="opt-label">Purpose</span>';
          html += '<select class="dt-purpose" data-id="' + dt.id + '"><option value="">-- Select purpose --</option>';
          PURPOSES.forEach(function(p) {
            html += '<option value="' + p + '">' + p + '</option>';
          });
          html += '</select></div>';

          /* Required / Optional */
          html += '<div class="opt-row"><span class="opt-label">Is this data required?</span>';
          html += '<label class="radio-label small"><input type="radio" name="req-' + dt.id + '" value="required" checked /> Required</label>';
          html += '<label class="radio-label small"><input type="radio" name="req-' + dt.id + '" value="optional" /> Optional</label>';
          html += '</div>';

          html += '</div>'; /* close dt-options */
          html += '</div>'; /* close data-type-row */
        });

        html += '</div>'; /* close data-category */
      });

      categorySections.innerHTML = html;
      attachTypeListeners();
    }

    function attachTypeListeners() {
      document.querySelectorAll('.dt-checkbox').forEach(function(cb) {
        cb.addEventListener('change', function() {
          var id = this.getAttribute('data-id');
          var opts = document.getElementById('opts-' + id);
          if (this.checked) {
            selectedTypes[id] = true;
            opts.style.display = 'block';
            /* Default to collected */
            var collectedCb = opts.querySelector('.dt-collected');
            if (collectedCb && !collectedCb.checked) {
              collectedCb.checked = true;
            }
          } else {
            delete selectedTypes[id];
            opts.style.display = 'none';
          }
          updateGenerateBtn();
        });
      });
    }

    function updateGenerateBtn() {
      generateBtn.disabled = Object.keys(selectedTypes).length === 0;
    }

    buildCategorySections();

    /* ───── COLLECTS DATA RADIO ───── */

    document.querySelectorAll('input[name="collects-data"]').forEach(function(radio) {
      radio.addEventListener('change', function() {
        if (this.value === 'yes') {
          dataTypeSections.style.display = 'block';
        } else {
          dataTypeSections.style.display = 'none';
        }
      });
    });

    /* ───── GENERATE ───── */

    generateBtn.addEventListener('click', function() {
      var selections = [];
      var encrypted = document.getElementById('encrypted-transit').checked;
      var deletable = document.getElementById('deletion-request').checked;

      Object.keys(selectedTypes).forEach(function(id) {
        var opts = document.getElementById('opts-' + id);
        var checkbox = document.querySelector('.dt-checkbox[data-id="' + id + '"]');
        var label = checkbox.getAttribute('data-label');
        var collected = opts.querySelector('.dt-collected').checked;
        var shared = opts.querySelector('.dt-shared').checked;
        var purpose = opts.querySelector('.dt-purpose').value;
        var reqRadios = document.querySelectorAll('input[name="req-' + id + '"]');
        var required = true;
        reqRadios.forEach(function(r) { if (r.checked && r.value === 'optional') required = false; });

        selections.push({
          id: id,
          label: label,
          collected: collected,
          shared: shared,
          purpose: purpose,
          required: required
        });
      });

      /* Build declarations */
      var lines = [];
      lines.push('<p><strong>Data Safety Declarations for Google Play Console</strong></p>');
      lines.push('<p><em>Generated on ' + new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) + ' -- verify against current Play Console before submitting.</em></p>');
      lines.push('<hr/>');

      lines.push('<p><strong>Security Practices</strong></p>');
      lines.push('<p>Data encrypted in transit: <strong>' + (encrypted ? 'Yes' : 'No') + '</strong></p>');
      lines.push('<p>Users can request data deletion: <strong>' + (deletable ? 'Yes' : 'No') + '</strong></p>');
      lines.push('<hr/>');

      /* Group by category for display */
      var catKeys = Object.keys(DATA_CATEGORIES);
      catKeys.forEach(function(catName) {
        var types = DATA_CATEGORIES[catName];
        var catSelections = [];

        types.forEach(function(dt) {
          var match = selections.filter(function(s) { return s.id === dt.id; });
          if (match.length > 0) catSelections.push(match[0]);
        });

        if (catSelections.length === 0) return;

        lines.push('<p><strong>' + catName + '</strong></p>');

        catSelections.forEach(function(s) {
          var handling = [];
          if (s.collected) handling.push('Collected');
          if (s.shared) handling.push('Shared');
          if (handling.length === 0) handling.push('Collected');

          var line = s.label + ': ' + handling.join(' & ') +
            ' | Purpose: ' + (s.purpose || 'Not specified') +
            ' | ' + (s.required ? 'Required' : 'Optional');
          lines.push('<p>' + line + '</p>');
        });

        lines.push('<hr/>');
      });

      declarationsText.innerHTML = lines.join('\n');

      /* Build summary table */
      var tableHtml = '<table class="data-table"><thead><tr><th>Data Type</th><th>Collected</th><th>Shared</th><th>Purpose</th><th>Required</th></tr></thead><tbody>';
      selections.forEach(function(s) {
        tableHtml += '<tr>';
        tableHtml += '<td>' + s.label + '</td>';
        tableHtml += '<td>' + (s.collected ? 'Yes' : 'No') + '</td>';
        tableHtml += '<td>' + (s.shared ? 'Yes' : 'No') + '</td>';
        tableHtml += '<td>' + (s.purpose || '--') + '</td>';
        tableHtml += '<td>' + (s.required ? 'Required' : 'Optional') + '</td>';
        tableHtml += '</tr>';
      });
      tableHtml += '</tbody></table>';
      summaryTableContainer.innerHTML = tableHtml;

      /* Check warnings */
      var warnings = checkWarnings(selections);
      if (warnings.length > 0) {
        var wHtml = '<h3 class="warnings-title">Warnings (' + warnings.length + ')</h3>';
        warnings.forEach(function(w) {
          wHtml += '<div class="warning-item ' + w.severity + '">';
          wHtml += '<span class="warning-icon">' + (w.severity === 'error' ? '&#9888;' : '&#9432;') + '</span>';
          wHtml += '<span class="warning-text">' + w.msg + '</span>';
          wHtml += '</div>';
        });
        warningsBox.innerHTML = wHtml;
        warningsContainer.style.display = 'block';
      } else {
        warningsContainer.style.display = 'none';
      }

      formDiv.style.display = 'none';
      resultsDiv.style.display = 'block';

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'tool_complete', tool: 'play_data_safety', types_selected: selections.length });

      resultsDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    /* ───── COPY ───── */

    copyBtn.addEventListener('click', function() {
      var el = document.getElementById('declarations-text');
      if (!el) return;
      var text = el.innerText;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function() { showCopyConfirm(); });
      } else {
        var textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        showCopyConfirm();
      }
    });

    function showCopyConfirm() {
      copyBtn.textContent = 'Copied!';
      setTimeout(function() { copyBtn.textContent = 'Copy to clipboard'; }, 2000);
    }

    /* ───── RESET ───── */

    resetBtn.addEventListener('click', function() {
      selectedTypes = {};
      document.querySelectorAll('.dt-checkbox').forEach(function(cb) { cb.checked = false; });
      document.querySelectorAll('.dt-options').forEach(function(o) { o.style.display = 'none'; });
      document.querySelectorAll('.dt-collected, .dt-shared').forEach(function(cb) { cb.checked = false; });
      document.querySelectorAll('.dt-purpose').forEach(function(sel) { sel.selectedIndex = 0; });
      document.querySelectorAll('input[name="collects-data"]').forEach(function(r) { r.checked = false; });
      document.getElementById('encrypted-transit').checked = true;
      document.getElementById('deletion-request').checked = false;
      dataTypeSections.style.display = 'none';
      generateBtn.disabled = true;
      resultsDiv.style.display = 'none';
      formDiv.style.display = 'block';
      formDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

</Layout>

