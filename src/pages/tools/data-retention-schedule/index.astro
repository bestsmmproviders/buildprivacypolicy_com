      ccpa:   { period: '12 months', sortVal: 12, reason: 'Reasonably necessary for stated purpose', law: 'CPRA §1798.100(d)', floorMonths: null },
      pipeda: { period: '12 months', sortVal: 12, reason: 'Retain only as long as necessary', law: 'PIPEDA Principle 4.5', floorMonths: null },
      lgpd:   { period: '12 months', sortVal: 12, reason: 'Purpose limitation for tracking identifiers', law: 'Art. 16 LGPD', floorMonths: null },
      dpdp:   { period: '12 months', sortVal: 12, reason: 'Erase when purpose is no longer served', law: 'Sec. 8(7) DPDP Act', floorMonths: null }
    },
    'children': {
      gdpr:   { period: 'Minimize and delete promptly', sortVal: 0, reason: 'Enhanced protections for minors; strict data minimization', law: 'Art. 8 + Art. 5(1)(c) GDPR', floorMonths: null },
      ccpa:   { period: 'Minimize and delete promptly', sortVal: 0, reason: 'COPPA requires deletion when purpose fulfilled; parental consent required', law: 'COPPA 16 CFR §312 + CPRA', floorMonths: null },
      pipeda: { period: 'Minimize and delete promptly', sortVal: 0, reason: 'Sensitive data of minors; strict minimization', law: 'PIPEDA Principle 4.4', floorMonths: null },
      lgpd:   { period: 'Minimize and delete promptly', sortVal: 0, reason: "Processing must be in child's best interest; minimize retention", law: 'Art. 14 LGPD', floorMonths: null },
      dpdp:   { period: 'Minimize and delete promptly', sortVal: 0, reason: 'Verifiable parental consent required; strict erasure obligations', law: 'Sec. 9 DPDP Act', floorMonths: null }
    }
  };
  var BUSINESS_NOTES = {
    app: {
      'device-id': 'App platforms may require device identifiers for crash reporting and push notifications — retain only for the active notification service lifecycle.',
      'children': 'App stores reject submissions without a COPPA-compliant privacy policy if your app is directed at or attracts children under 13.'
    },
    website: {
      'cookies': 'Implement a cookie consent manager to track user preferences and honor opt-outs across sessions.',
      'ip-address': 'Configure server log rotation to auto-purge IP addresses at the recommended interval.'
    },
    saas: {
      'account-email': 'Document the post-cancellation data cleanup window in your terms of service so subscribers know when their data will be erased.',
      'payment': 'Subscription billing records may need retention beyond the tax floor for chargeback dispute resolution (typically 120–540 days depending on processor).'
    },
    ecommerce: {
      'payment': 'Card network rules (Visa, Mastercard) allow chargebacks up to 540 days post-transaction — retain enough data to respond to disputes within that window.',
      'name': 'Shipping and order records containing customer names are typically retained alongside payment records for tax and warranty compliance.'
    }
  };

  var form        = document.getElementById('builder-form');
  var resultsDiv  = document.getElementById('results');
  var generateBtn = document.getElementById('generate-btn');
  var resetBtn    = document.getElementById('reset-btn');
  var copyBtn     = document.getElementById('copy-btn');
  var copyFeedback = document.getElementById('copy-feedback');
  var tbody       = document.getElementById('retention-tbody');
  var floorNotes  = document.getElementById('floor-notes');
  var bizNotes    = document.getElementById('business-notes');
  var clipBox     = document.getElementById('clipboard-box');
  var bizSelect   = document.getElementById('business-type');
  var selAllData  = document.getElementById('select-all-data');
  var selAllJuris = document.getElementById('select-all-juris');

  function toggleSelectAll(groupName, btn) {
    var boxes = document.querySelectorAll('input[name="' + groupName + '"]'  );
    var allChecked = Array.prototype.every.call(boxes, function (b) { return b.checked; });
    boxes.forEach(function (b) {
      b.checked = !allChecked;
      b.closest('.check-card').classList.toggle('checked', b.checked);
    });
    btn.textContent = allChecked ? 'Select all' : 'Deselect all';
    updateGenerateBtn();
  }

  selAllData.addEventListener('click', function () { toggleSelectAll('dataType', selAllData); });
  selAllJuris.addEventListener('click', function () { toggleSelectAll('jurisdiction', selAllJuris); });

  function getChecked(name) {
    return Array.prototype.map.call(
      document.querySelectorAll('input[name="' + name + '"]:checked'),
      function (el) { return el.value; }
    );
  }

  function updateGenerateBtn() {
    generateBtn.disabled = !(getChecked('dataType').length && getChecked('jurisdiction').length && bizSelect.value);
  }

  document.querySelectorAll('input[name="dataType"], input[name="jurisdiction"]').forEach(function (el) {
    el.addEventListener('change', updateGenerateBtn);
  });
  bizSelect.addEventListener('change', updateGenerateBtn);

  document.querySelectorAll('.check-card input[type="checkbox"]').forEach(function (cb) {
    cb.addEventListener('change', function () {
      this.closest('.check-card').classList.toggle('checked', this.checked);
    });
  });
  function dataLabel(id) {
    for (var i = 0; i < DATA_TYPES.length; i++) { if (DATA_TYPES[i].id === id) return DATA_TYPES[i].label; }
    return id;
  }
  function jurisLabel(id) {
    for (var i = 0; i < JURISDICTIONS.length; i++) { if (JURISDICTIONS[i].id === id) return JURISDICTIONS[i].label; }
    return id;
  }

  generateBtn.addEventListener('click', function () {
    var selTypes  = getChecked('dataType');
    var selJuris  = getChecked('jurisdiction');
    var selBiz    = bizSelect.value;
    if (!selTypes.length || !selJuris.length || !selBiz) return;

    tbody.innerHTML = '';
    var floors = [];
    var bizNotesArr = [];
    var paragraphParts = [];

    selTypes.forEach(function (typeId) {
      var entries = [];
      var maxFloor = null;
      var maxFloorEntry = null;

      selJuris.forEach(function (jId) {
        var entry = RETENTION[typeId] && RETENTION[typeId][jId];
        if (!entry) return;
        entries.push({ jId: jId, entry: entry });
        if (entry.floorMonths !== null) {
          if (maxFloor === null || entry.floorMonths > maxFloor) {
            maxFloor = entry.floorMonths;
            maxFloorEntry = { jId: jId, entry: entry };
          }
        }
      });

      if (!entries.length) return;
      entries.sort(function (a, b) { return a.entry.sortVal - b.entry.sortVal; });

      var pick;
      if (maxFloor !== null) {
        pick = maxFloorEntry;
      } else {
        pick = entries[0];
      }

      var label = dataLabel(typeId);

      var tr = document.createElement('tr');
      tr.innerHTML =
        '<td data-label="Data Type">' + label + '</td>' +
        '<td data-label="Retention">' + pick.entry.period + '</td>' +
        '<td data-label="Reason">' + pick.entry.reason + '</td>' +
        '<td data-label="Law">' + pick.entry.law + ' (' + jurisLabel(pick.jId) + ')' + '</td>';
      tbody.appendChild(tr);

      if (maxFloor !== null) {
        var floorYears = maxFloor >= 12 ? (maxFloor / 12) : maxFloor;
        var floorUnit  = maxFloor >= 12 ? 'year' + (floorYears !== 1 ? 's' : '') : 'month' + (maxFloor !== 1 ? 's' : '');
        floors.push(label + ': statutory minimum of ' + floorYears + ' ' + floorUnit + ' (' + pick.entry.law + ').');
      }

      if (BUSINESS_NOTES[selBiz] && BUSINESS_NOTES[selBiz][typeId]) {
        bizNotesArr.push('<strong>' + label + ':</strong> ' + BUSINESS_NOTES[selBiz][typeId]);
      }

      paragraphParts.push(label.toLowerCase() + ' for ' + pick.entry.period.toLowerCase());
    });

    if (floors.length) {
      floorNotes.innerHTML = '<strong>Statutory minimums:</strong> ' + floors.join(' ');
      floorNotes.style.display = 'block';
    } else {
      floorNotes.style.display = 'none';
    }

    if (bizNotesArr.length) {
      bizNotes.innerHTML = '<strong>Notes for your business type (' + selBiz + '):</strong><ul>' +
        bizNotesArr.map(function (n) { return '<li>' + n + '</li>'; }).join('') + '</ul>';
      bizNotes.style.display = 'block';
    } else {
      bizNotes.style.display = 'none';
    }

    var jurisdictionNames = selJuris.map(jurisLabel).join(', ');
    var para = 'We retain personal data only for as long as necessary to fulfill the purposes for which it was collected, in accordance with applicable data protection laws including ' + jurisdictionNames + '. Specifically, we retain ' + paragraphParts.join('; ') + '. ';
    if (floors.length) {
      para += 'Certain records are subject to statutory minimum retention periods required by tax and accounting law: ' + floors.join(' ') + ' ';
    }
    para += 'When the applicable retention period expires, data is securely deleted or anonymized. These retention periods reflect common regulatory defaults and may be adjusted as laws evolve. This schedule does not constitute legal advice.';

    clipBox.textContent = para;

    form.style.display = 'none';
    resultsDiv.style.display = 'block';
    resultsDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'tool_complete', data_types_count: selTypes.length, jurisdictions_count: selJuris.length });
  });

  copyBtn.addEventListener('click', function () {
    var text = clipBox.textContent;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () {
        copyFeedback.textContent = 'Copied!';
        setTimeout(function () { copyFeedback.textContent = ''; }, 2000);
      });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      copyFeedback.textContent = 'Copied!';
      setTimeout(function () { copyFeedback.textContent = ''; }, 2000);
    }
  });

  resetBtn.addEventListener('click', function () {
    document.querySelectorAll('input[name="dataType"], input[name="jurisdiction"]').forEach(function (el) {
      el.checked = false;
      el.closest('.check-card').classList.remove('checked');
    });
    bizSelect.value = '';
    generateBtn.disabled = true;
    selAllData.textContent = 'Select all';
    selAllJuris.textContent = 'Select all';
    resultsDiv.style.display = 'none';
    form.style.display = 'block';
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
});
</script>

</Layout>

<style>
