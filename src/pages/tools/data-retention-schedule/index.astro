  .last-updated { font-size: 13px; color: #9CA3AF; margin-bottom: 24px; }
  .page-card h2 { font-size: 20px; font-weight: 700; color: #111827; margin-top: 36px; margin-bottom: 12px; letter-spacing: -0.3px; }
  .page-card h3 { font-size: 17px; font-weight: 600; color: #111827; margin-top: 24px; margin-bottom: 8px; }
  .page-card p { font-size: 15px; color: #374151; line-height: 1.75; margin-bottom: 14px; }
  .page-card a { color: #2563EB; text-decoration: underline; }
  .page-card strong { font-weight: 600; }

  .tool-container { margin: 28px 0 12px; background: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 10px; padding: 28px 24px; }
  .form-section { margin-bottom: 24px; }
  .section-label { display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 10px; }
