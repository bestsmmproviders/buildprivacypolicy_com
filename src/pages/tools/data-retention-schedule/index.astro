    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .header-left { display: flex; align-items: center; }
  .logo-link { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .logo-link:hover { text-decoration: none; }
  .logo-icon { width: 28px; height: 28px; border-radius: 6px; flex-shrink: 0; }
  .logo-text { font-size: 18px; font-weight: 700; color: #111827; letter-spacing: -0.3px; }
  .page-container { max-width: 780px; margin: 0 auto; padding: 32px 16px 80px; }
