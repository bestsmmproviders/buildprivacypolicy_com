  .floor-notes { background: #FEF3C7; border: 1px solid #FDE68A; border-radius: 8px; padding: 14px 18px; font-size: 13px; color: #92400E; line-height: 1.6; margin-bottom: 16px; }
  .business-notes { background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 8px; padding: 14px 18px; font-size: 13px; color: #1E40AF; line-height: 1.6; margin-bottom: 16px; }
