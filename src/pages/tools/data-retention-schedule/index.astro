  .clipboard-section { margin-top: 24px; padding-top: 20px; border-top: 1px solid #E5E7EB; }
  .clipboard-section h3 { margin-top: 0 !important; margin-bottom: 6px !important; font-size: 16px; font-weight: 700; color: #111827; }
  .clipboard-hint { font-size: 13px !important; color: #6B7280 !important; margin-bottom: 10px !important; }
  .clipboard-box { background: white; border: 1px solid #D1D5DB; border-radius: 8px; padding: 16px; font-size: 14px; color: #374151; line-height: 1.7; margin-bottom: 10px; user-select: all; }
  .copy-btn { padding: 8px 18px; font-size: 14px; font-weight: 600; font-family: inherit; color: white; background: #2563EB; border: none; border-radius: 6px; cursor: pointer; transition: background 0.15s; }
  .copy-btn:hover { background: #1D4ED8; }
  .copy-feedback { margin-left: 10px; font-size: 13px; font-weight: 600; color: #059669; }

  .reset-btn { margin-top: 20px; padding: 10px 20px; font-size: 14px; font-weight: 600; font-family: inherit; color: #374151; background: white; border: 1px solid #D1D5DB; border-radius: 8px; cursor: pointer; transition: background 0.15s; }
  .reset-btn:hover { background: #F9FAFB; }

  .faq-list { margin-top: 8px; }
  .faq-item { border-top: 1px solid #E5E7EB; padding-top: 20px; margin-bottom: 8px; }
  .faq-item h3 { margin-top: 0; }
  .faq-item p { margin-bottom: 8px; }

  @media (max-width: 600px) {
    .page-card { padding: 24px 18px; }
    .page-container { max-width: 100%; }
    .tool-container { padding: 20px 16px; }
    .checkbox-grid { grid-template-columns: 1fr 1fr; }
    .retention-table thead { display: none; }
    .retention-table, .retention-table tbody, .retention-table tr, .retention-table td { display: block; width: 100%; }
    .retention-table tr { margin-bottom: 12px; border: 1px solid #E5E7EB; border-radius: 8px; padding: 12px; background: white; }
    .retention-table td { padding: 4px 0; border-bottom: none; }
    .retention-table td::before { content: attr(data-label) ": "; font-weight: 600; color: #111827; }
    .retention-table td:first-child { font-weight: 600; color: #111827; }
    .retention-table td:first-child::before { display: none; }
  }
</style>
