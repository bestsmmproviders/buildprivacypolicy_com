const description = "Free California website privacy policy template. Covers CCPA/CPRA thresholds, the categories table, consumer rights, Do Not Sell or Share, and CalOPPA rules.";
const publishDate = "2026-11-13";
const modifiedDate = "2026-11-13";

const faqs = [
  {
    q: "Do I need a CCPA privacy policy on my website?",
    a: "Only if your business meets a CCPA threshold: over $26,625,000 in annual revenue, personal information of 100,000+ California consumers or households bought, sold, or shared a year, or half its revenue from selling or sharing it. Below those, CalOPPA still requires a posted policy on any commercial website collecting personal information from Californians."
  },
  {
    q: "What are California's privacy rights?",
    a: "California residents can ask a covered business to disclose, delete, or correct their personal information, opt out of its sale or sharing, limit the use of sensitive personal information, and use these rights without being charged more or served worse."
  },
  {
    q: "How do you opt out under the California Consumer Privacy Act?",
    a: "Use the business's \"Do Not Sell or Share My Personal Information\" link, or turn on an opt-out preference signal such as Global Privacy Control in your browser. Businesses that sell or share must honor that signal and cannot require an account to opt out."
  },
  {
    q: "What does \"Do Not Sell or Share My Personal Information\" mean?",
    a: "It is the required title of the homepage link a business must provide if it sells personal information or shares it for cross-context behavioral advertising. The link leads to a page where a California consumer can stop that selling or sharing."
  },
  {
    q: "How can I create a privacy policy for my website?",
    a: "List the personal information your site collects and every tool that receives it, then explain why, how long you keep it, and how people use their rights. For California, add the categories table, rights list, and sale and sharing statement shown above."
  },
  {
    q: "What is California's regulation and best practice regarding privacy?",
    a: "The CCPA as amended by the CPRA (Civil Code §1798.100 onward), enforced by the California Privacy Protection Agency and the Attorney General, with regulations at 11 CCR §7000 onward, plus CalOPPA (Business and Professions Code §22575) for all commercial websites. Both expect an accurate, dated policy; the CCPA requires review every 12 months."
  }
];
